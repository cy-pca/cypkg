# views.ari: cypkg's two views, as units for the modules search.ari and package.ari to include.
#
# Units share the including document's scope. The modules search.ari and package.ari include
# them, so the bind paths here are a module's own state (search.*, pkg.*) plus the holes main.ari
# grants it (view, nav, args). tests/unit/ includes the same units in test documents over seeded
# state, with no network.
#
# The contract. The views read:
#   view                      "search" or "package"; each unit shows only for its own
#   args.page                 rows per page
#   search.q .platform .arch .link .offset .count .total .status
#   search.res.packages.{i}.name .version .platform .arch .link .size_bytes
#   pkg.name .desc .version .license .homepage .tags .install .status .offset .count .total
#   pkg.page.{i}.version .where .kind .size .date
#   search.bar, pkg.bar       a progress bar while a request is in flight ("" otherwise)
# The views write:
#   search.q .platform .arch .link .offset, and req.search "1" to ask for a search
#   nav.open, and view "package", to open a package (the package module reads nav.open)
#   pkg.offset, and req.pkgpage "1" to ask for another page of builds
#   view                      "search", from Back


meta:
  name: cypkg-views
  min_libcvc: 3.7.4

units:
  search_view:
    type: group
    visible_when: (= (state-get "view") "search")
    children:
      - type: group
        layout: { kind: grid, col_widths: [296, 176, 152, 160] }
        children:
          - type: input_text
            label: "Search"
            bind: search.q
            on: (begin (state-set "search.offset" 0) (state-set "req.search" "1"))
          - type: combo
            label: "Platform"
            bind: search.platform
            options: [all, linux, macos, windows, freebsd, openbsd, netbsd, haiku, wasm, wasm-mt, wasi, cosmo, any]
          - type: combo
            label: "Arch"
            bind: search.arch
            options: [all, x86_64, arm64, wasm32, noarch]
          - type: combo
            label: "Link"
            bind: search.link
            options: [all, shared, static]
      - text: ""
        bind: search.status
      - separator
      - type: group
        layout: { kind: grid, col_widths: [64, 232, 144, 144, 64, 80] }
        visible_when: (> (int (state-get "search.count")) 0)
        children:
          - text: ""
          - text: "name"
          - text: "version"
          - text: "platform"
          - text: "link"
          - text: "size"
      - type: group
        repeat: (state-get "search.count")
        children:
          - type: group
            id: hit{i}
            layout: { kind: grid, col_widths: [64, 232, 144, 144, 64, 80] }
            children:
              - type: button
                label: "Open"
                on: (begin (state-set "nav.open" (state-get "search.res.packages.{i}.name"))
                           (state-set "view" "package"))
              # Cut to the column (28 cells), or it runs into the next one.
              - text: ""
                bind: '(let ((n (state-get "search.res.packages.{i}.name"))) (if (> (string.length n) 28) (string.join (list (string.substring n 0 27) "…") "") n))'
              - text: ""
                bind: search.res.packages.{i}.version
              - text: ""
                bind: '(string.join (list (state-get "search.res.packages.{i}.platform") (state-get "search.res.packages.{i}.arch")) "/")'
              - text: ""
                bind: search.res.packages.{i}.link
              - text: ""
                bind: '(let ((b (state-get "search.res.packages.{i}.size_bytes"))) (if (= b "") "" (if (< (int b) 1024) (string.join (list b "B") " ") (string.join (list (str (int (/ (int b) 1024))) "KB") " "))))'
      - separator
      - type: group
        layout: { kind: horizontal }
        visible_when: (> (int (state-get "search.total")) (int (state-get "args.page")))
        children:
          - type: button
            label: "< Prev"
            enabled_when: (> (int (state-get "search.offset")) 0)
            on: |
              (begin
                (state-set "search.offset"
                  (let ((o (- (int (state-get "search.offset")) (int (state-get "args.page"))))) (if (< o 0) 0 o)))
                (state-set "req.search" "1"))
          - type: button
            label: "Next >"
            enabled_when: (< (+ (int (state-get "search.offset")) (int (state-get "search.count"))) (int (state-get "search.total")))
            on: |
              (begin
                (state-set "search.offset"
                  (+ (int (state-get "search.offset")) (int (state-get "args.page"))))
                (state-set "req.search" "1"))
      # The progress bar: the search module draws search.bar while a request is in flight.
      - text: ""
        bind: search.bar


  package_view:
    type: group
    visible_when: (= (state-get "view") "package")
    children:
      - type: button
        label: "< Back"
        on: (state-set "view" "search")
      - text: "package"
        bind: pkg.name
      - type: group
        visible_when: (> (int (state-get "pkg.count")) 0)
        children:
          - text: ""
            bind: pkg.desc
          - text: "latest"
            bind: pkg.version
          - text: "license"
            bind: pkg.license
          - text: "homepage"
            bind: pkg.homepage
          - text: "tags"
            bind: pkg.tags
          - text: "install"
            bind: pkg.install
      - separator
      - text: ""
        bind: pkg.status
      - type: group
        layout: { kind: grid, col_widths: [144, 176, 128, 104, 104] }
        visible_when: (> (int (state-get "pkg.count")) 0)
        children:
          - text: "version"
          - text: "platform"
          - text: "build"
          - text: "size"
          - text: "published"
      - type: group
        repeat: (state-get "pkg.count")
        children:
          - type: group
            id: build{i}
            layout: { kind: grid, col_widths: [144, 176, 128, 104, 104] }
            children:
              - text: ""
                bind: pkg.page.{i}.version
              - text: ""
                bind: pkg.page.{i}.where
              - text: ""
                bind: pkg.page.{i}.kind
              - text: ""
                bind: pkg.page.{i}.size
              - text: ""
                bind: pkg.page.{i}.date
      - separator
      - type: group
        layout: { kind: horizontal }
        visible_when: (> (int (state-get "pkg.total")) (int (state-get "args.page")))
        children:
          - type: button
            label: "< Prev"
            enabled_when: (> (int (state-get "pkg.offset")) 0)
            on: |
              (begin
                (state-set "pkg.offset"
                  (let ((o (- (int (state-get "pkg.offset")) (int (state-get "args.page"))))) (if (< o 0) 0 o)))
                (state-set "req.pkgpage" "1"))
          - type: button
            label: "Next >"
            enabled_when: (< (+ (int (state-get "pkg.offset")) (int (state-get "pkg.count"))) (int (state-get "pkg.total")))
            on: |
              (begin
                (state-set "pkg.offset"
                  (+ (int (state-get "pkg.offset")) (int (state-get "args.page"))))
                (state-set "req.pkgpage" "1"))
      # The progress bar: the package module draws pkg.bar while a request is in flight.
      - text: ""
        bind: pkg.bar

  # ── The fleet windows (main.ari's View menu opens them). Each module keeps its reply under its
  # own name (builders.*, builds.*, activity.*) and draws <name>.bar while a request is in flight.

  builders_view:
    type: group
    children:
      - type: group
        layout: { kind: horizontal }
        children:
          - type: button
            label: "Refresh"
            on: (state-set "req.refresh" "1")
          - text: ""
            bind: builders.status
      - separator
      - type: group
        layout: { kind: grid, col_widths: [152, 136, 64, 48, 64, 128] }
        visible_when: (> (int (state-get "builders.count")) 0)
        children:
          - text: "name"
          - text: "platform"
          - text: "status"
          - text: "jobs"
          - text: "version"
          - text: "heartbeat"
      - type: group
        repeat: (state-get "builders.count")
        children:
          - type: group
            id: builder{i}
            layout: { kind: grid, col_widths: [152, 136, 64, 48, 64, 128] }
            children:
              - text: ""
                bind: '(let ((n (state-get "builders.res.builders.{i}.name"))) (if (> (string.length n) 18) (string.join (list (string.substring n 0 17) "…") "") n))'
              - text: ""
                bind: '(string.join (list (state-get "builders.res.builders.{i}.platform") (state-get "builders.res.builders.{i}.arch")) "/")'
              - text: ""
                bind: builders.res.builders.{i}.status
              - text: ""
                bind: '(string.join (list (state-get "builders.res.builders.{i}.current_jobs") (state-get "builders.res.builders.{i}.max_jobs")) "/")'
              - text: ""
                bind: '(let ((v (state-get "builders.res.builders.{i}.version"))) (if (> (string.length v) 7) (string.join (list (string.substring v 0 6) "…") "") v))'
              - text: ""
                bind: '(string.replace (string.substring (state-get "builders.res.builders.{i}.last_heartbeat") 0 16) "T" " ")'
      - text: ""
        bind: builders.bar

  builds_view:
    type: group
    children:
      - type: group
        layout: { kind: grid, col_widths: [200, 104, 300] }
        children:
          - type: combo
            label: "Status"
            bind: builds.filter
            options: [all, queued, running, succeeded, failed, cancelled]
            on: (state-set "req.refresh" "1")
          - type: button
            label: "Refresh"
            on: (state-set "req.refresh" "1")
          - text: ""
            bind: builds.status
      - separator
      - type: group
        layout: { kind: grid, col_widths: [56, 176, 136, 80, 48, 128] }
        visible_when: (> (int (state-get "builds.count")) 0)
        children:
          - text: "job"
          - text: "recipe"
          - text: "platform"
          - text: "status"
          - text: "on"
          - text: "submitted"
      - type: group
        repeat: (state-get "builds.count")
        children:
          - type: group
            id: build{i}
            layout: { kind: grid, col_widths: [56, 176, 136, 80, 48, 128] }
            children:
              - text: ""
                bind: builds.res.jobs.{i}.id
              - text: ""
                bind: '(let ((n (state-get "builds.res.jobs.{i}.recipe_name"))) (if (> (string.length n) 21) (string.join (list (string.substring n 0 20) "…") "") n))'
              - text: ""
                bind: '(string.join (list (state-get "builds.res.jobs.{i}.platform") (state-get "builds.res.jobs.{i}.arch")) "/")'
              - text: ""
                bind: builds.res.jobs.{i}.status
              - text: ""
                bind: builds.res.jobs.{i}.builder_id
              - text: ""
                bind: '(string.replace (string.substring (state-get "builds.res.jobs.{i}.submitted_at") 0 16) "T" " ")'
      - separator
      - type: group
        layout: { kind: horizontal }
        visible_when: (> (int (state-get "builds.total")) (int (state-get "args.page")))
        children:
          - type: button
            label: "< Newer"
            enabled_when: (> (int (state-get "builds.offset")) 0)
            on: |
              (begin
                (state-set "builds.offset"
                  (let ((o (- (int (state-get "builds.offset")) (int (state-get "args.page"))))) (if (< o 0) 0 o)))
                (state-set "req.refresh" "1"))
          - type: button
            label: "Older >"
            enabled_when: (< (+ (int (state-get "builds.offset")) (int (state-get "builds.count"))) (int (state-get "builds.total")))
            on: |
              (begin
                (state-set "builds.offset" (+ (int (state-get "builds.offset")) (int (state-get "args.page"))))
                (state-set "req.refresh" "1"))
      - text: ""
        bind: builds.bar

  activity_view:
    type: group
    children:
      - type: group
        layout: { kind: horizontal }
        children:
          - type: button
            label: "Refresh"
            on: (state-set "req.refresh" "1")
          - text: ""
            bind: activity.status
      - separator
      - type: group
        layout: { kind: grid, col_widths: [136, 72, 176, 128, 136] }
        visible_when: (> (int (state-get "activity.count")) 0)
        children:
          - text: "when"
          - text: "event"
          - text: "package"
          - text: "version"
          - text: "platform"
      - type: group
        repeat: (state-get "activity.count")
        children:
          - type: group
            id: event{i}
            layout: { kind: grid, col_widths: [136, 72, 176, 128, 136] }
            children:
              - text: ""
                bind: '(string.replace (string.substring (state-get "activity.res.events.{i}.created_at") 0 16) "T" " ")'
              - text: ""
                bind: activity.res.events.{i}.kind
              - text: ""
                bind: '(let ((n (state-get "activity.res.events.{i}.name"))) (if (> (string.length n) 22) (string.join (list (string.substring n 0 21) "…") "") n))'
              - text: ""
                bind: '(let ((v (state-get "activity.res.events.{i}.version"))) (if (> (string.length v) 15) (string.join (list (string.substring v 0 14) "…") "") v))'
              - text: ""
                bind: '(string.join (list (state-get "activity.res.events.{i}.platform") (state-get "activity.res.events.{i}.arch")) "/")'
      - text: ""
        bind: activity.bar

  # The account window: who the registry says you are, and signing in and out.
  account_view:
    type: group
    children:
      - text: ""
        bind: account.status
      - type: group
        visible_when: (= (state-get "account.signed_in") "1")
        children:
          - text: "name"
            bind: account.who.name
          - text: "role"
            bind: account.who.role
          - text: "signed in with"
            bind: account.who.kind
          - text: "orgs"
            bind: account.orgs
          - type: button
            label: "Sign out"
            on: (state-set "req.signout" "1")
      - separator
      - type: group
        visible_when: (!= (state-get "account.signed_in") "1")
        children:
          - text: "With an API token: run cypkg --token-env VAR, where VAR holds a cvctok_ token."
          - text: ""
            bind: account.pairing_note
          - type: button
            label: "Sign in with a browser"
            enabled_when: (= (state-get "account.can_pair") "1")
            on: (state-set "req.pair" "1")
          - text: "code"
            bind: account.code
            visible_when: (!= (state-get "account.code") "")
          - text: "approve at"
            bind: account.url
            visible_when: (!= (state-get "account.url") "")
      - text: ""
        bind: account.bar

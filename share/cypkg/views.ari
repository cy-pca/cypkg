# views.ari: cypkg's two views, as units for the modules search.ari and package.ari to include.
#
# Units share the including document's scope. The modules search.ari and package.ari include
# them, so the bind paths here are a module's own state (search.*, pkg.*) plus the holes main.ari
# grants it (view, nav, args). tests/unit/ includes the same units in test documents over seeded
# state, with no network.
#
# The contract. The views read:
#   view                      "search" or "package"; each unit shows only for its own
#   args.page                 rows per page
#   search.q .platform .arch .link .offset .count .total .status
#   search.res.packages.{i}.name .version .platform .arch .link .size_bytes
#   pkg.name .desc .version .license .homepage .tags .install .status .offset .count .total
#   pkg.page.{i}.version .where .kind .size .date
#   search.bar, pkg.bar       a progress bar while a request is in flight ("" otherwise)
# The views write:
#   search.q .platform .arch .link .offset, and req.search "1" to ask for a search
#   nav.open, and view "package", to open a package (the package module reads nav.open)
#   pkg.offset, and req.pkgpage "1" to ask for another page of builds
#   view                      "search", from Back


meta:
  name: cypkg-views
  min_libcvc: 3.7.4

units:
  search_view:
    type: group
    visible_when: (= (state-get "view") "search")
    children:
      - type: group
        layout: { kind: grid, col_widths: [296, 176, 152, 160] }
        children:
          - type: input_text
            label: "Search"
            bind: search.q
            on: (begin (state-set "search.offset" 0) (state-set "req.search" "1"))
          - type: combo
            label: "Platform"
            bind: search.platform
            options: [all, linux, macos, windows, freebsd, openbsd, netbsd, haiku, wasm, wasm-mt, wasi, cosmo, any]
            on: (begin (state-set "search.offset" 0) (state-set "req.search" "1"))
          - type: combo
            label: "Arch"
            bind: search.arch
            options: [all, x86_64, arm64, wasm32, noarch]
            on: (begin (state-set "search.offset" 0) (state-set "req.search" "1"))
          - type: combo
            label: "Link"
            bind: search.link
            options: [all, shared, static]
            on: (begin (state-set "search.offset" 0) (state-set "req.search" "1"))
      - text: ""
        bind: search.status
      - separator
      - type: group
        layout: { kind: grid, col_widths: [64, 232, 144, 144, 64, 80] }
        visible_when: (> (int (state-get "search.count")) 0)
        children:
          - text: ""
          - text: "name"
          - text: "version"
          - text: "platform"
          - text: "link"
          - text: "size"
      - type: group
        repeat: (state-get "search.count")
        children:
          - type: group
            id: hit{i}
            layout: { kind: grid, col_widths: [64, 232, 144, 144, 64, 80] }
            children:
              - type: button
                label: "Open"
                on: (begin (state-set "nav.open" (state-get "search.res.packages.{i}.name"))
                           (state-set "view" "package"))
              # Cut to the column (28 cells), or it runs into the next one.
              - text: ""
                bind: '(let ((n (state-get "search.res.packages.{i}.name"))) (if (> (string.length n) 28) (string.join (list (string.substring n 0 27) "…") "") n))'
              - text: ""
                bind: search.res.packages.{i}.version
              - text: ""
                bind: '(string.join (list (state-get "search.res.packages.{i}.platform") (state-get "search.res.packages.{i}.arch")) "/")'
              - text: ""
                bind: search.res.packages.{i}.link
              - text: ""
                bind: '(let ((b (state-get "search.res.packages.{i}.size_bytes"))) (if (= b "") "" (if (< (int b) 1024) (string.join (list b "B") " ") (string.join (list (str (int (/ (int b) 1024))) "KB") " "))))'
      - separator
      - type: group
        layout: { kind: horizontal }
        visible_when: (> (int (state-get "search.total")) (int (state-get "args.page")))
        children:
          - type: button
            label: "< Prev"
            enabled_when: (> (int (state-get "search.offset")) 0)
            on: |
              (begin
                (state-set "search.offset"
                  (let ((o (- (int (state-get "search.offset")) (int (state-get "args.page"))))) (if (< o 0) 0 o)))
                (state-set "req.search" "1"))
          - type: button
            label: "Next >"
            enabled_when: (< (+ (int (state-get "search.offset")) (int (state-get "search.count"))) (int (state-get "search.total")))
            on: |
              (begin
                (state-set "search.offset"
                  (+ (int (state-get "search.offset")) (int (state-get "args.page"))))
                (state-set "req.search" "1"))
      # The progress bar: the search module draws search.bar while a request is in flight.
      - text: ""
        bind: search.bar


  package_view:
    type: group
    visible_when: (= (state-get "view") "package")
    children:
      - type: button
        label: "< Back"
        on: (state-set "view" "search")
      - text: "package"
        bind: pkg.name
      - type: group
        visible_when: (> (int (state-get "pkg.count")) 0)
        children:
          - text: ""
            bind: pkg.desc
          - text: "latest"
            bind: pkg.version
          - text: "license"
            bind: pkg.license
          - text: "homepage"
            bind: pkg.homepage
          - text: "tags"
            bind: pkg.tags
          - text: "install"
            bind: pkg.install
      - separator
      - text: ""
        bind: pkg.status
      - type: group
        layout: { kind: grid, col_widths: [144, 176, 128, 104, 104] }
        visible_when: (> (int (state-get "pkg.count")) 0)
        children:
          - text: "version"
          - text: "platform"
          - text: "build"
          - text: "size"
          - text: "published"
      - type: group
        repeat: (state-get "pkg.count")
        children:
          - type: group
            id: build{i}
            layout: { kind: grid, col_widths: [144, 176, 128, 104, 104] }
            children:
              - text: ""
                bind: pkg.page.{i}.version
              - text: ""
                bind: pkg.page.{i}.where
              - text: ""
                bind: pkg.page.{i}.kind
              - text: ""
                bind: pkg.page.{i}.size
              - text: ""
                bind: pkg.page.{i}.date
      - separator
      - type: group
        layout: { kind: horizontal }
        visible_when: (> (int (state-get "pkg.total")) (int (state-get "args.page")))
        children:
          - type: button
            label: "< Prev"
            enabled_when: (> (int (state-get "pkg.offset")) 0)
            on: |
              (begin
                (state-set "pkg.offset"
                  (let ((o (- (int (state-get "pkg.offset")) (int (state-get "args.page"))))) (if (< o 0) 0 o)))
                (state-set "req.pkgpage" "1"))
          - type: button
            label: "Next >"
            enabled_when: (< (+ (int (state-get "pkg.offset")) (int (state-get "pkg.count"))) (int (state-get "pkg.total")))
            on: |
              (begin
                (state-set "pkg.offset"
                  (+ (int (state-get "pkg.offset")) (int (state-get "args.page"))))
                (state-set "req.pkgpage" "1"))
      # The progress bar: the package module draws pkg.bar while a request is in flight.
      - text: ""
        bind: pkg.bar

  # ── The fleet windows (main.ari's View menu opens them). Each module keeps its reply under its
  # own name (builders.*, builds.*, activity.*) and draws <name>.bar while a request is in flight.

  builders_view:
    type: group
    children:
      - type: group
        layout: { kind: horizontal }
        children:
          - type: button
            label: "Refresh"
            on: (state-set "req.refresh" "1")
          - text: ""
            bind: builders.status
      - separator
      # A card each: name, status, platform and version (coloured by status: online green, busy
      # amber, offline grey), then its jobs and its host's CPU, memory and disk, then its last
      # heartbeat, org and labels. Details opens the Builder window on it; outside a terminal, a
      # click anywhere on the card does too. They hand on the id as state-get gives it, text:
      # (str ...) of text quotes it, and /v1/builders/"1" is a 422.
      - type: group
        repeat: (state-get "builders.count")
        children:
          - type: group
            id: builder{i}
            layout: { kind: grid, col_widths: ["100%"], borders: { show: outer } }
            on_click: (if (has? "ui.group_click") (state-set "req.open" (state-get "builders.res.builders.{i}.id")))
            hover: highlight
            children:
              - type: group
                layout: { kind: horizontal }
                children:
                  - type: button
                    label: "Details"
                    on: (state-set "req.open" (state-get "builders.res.builders.{i}.id"))
                  - text: ""
                    bind: builders.res.builders.{i}.head
                    color: [0.45, 0.8, 0.55]
                    visible_when: (= (state-get "builders.res.builders.{i}.status") "online")
                  - text: ""
                    bind: builders.res.builders.{i}.head
                    color: [0.95, 0.72, 0.3]
                    visible_when: (= (state-get "builders.res.builders.{i}.status") "busy")
                  - text: ""
                    bind: builders.res.builders.{i}.head
                    color: [0.6, 0.6, 0.6]
                    visible_when: (and (!= (state-get "builders.res.builders.{i}.status") "online") (!= (state-get "builders.res.builders.{i}.status") "busy"))
              - text: ""
                bind: builders.res.builders.{i}.load
              - text: ""
                bind: builders.res.builders.{i}.seen
                color: [0.6, 0.6, 0.6]
      - text: ""
        bind: builders.bar

  builds_view:
    type: group
    children:
      - type: group
        layout: { kind: grid, col_widths: [200, 104, 300] }
        children:
          - type: combo
            label: "Status"
            bind: builds.filter
            options: [all, queued, running, succeeded, failed, cancelled]
            on: (state-set "req.refresh" "1")
          - type: button
            label: "Refresh"
            on: (state-set "req.refresh" "1")
          - text: ""
            bind: builds.status
      - separator
      - type: group
        layout: { kind: grid, col_widths: [56, 176, 136, 80, 48, 128] }
        visible_when: (> (int (state-get "builds.count")) 0)
        children:
          - text: "job"
          - text: "recipe"
          - text: "platform"
          - text: "status"
          - text: "on"
          - text: "submitted"
      - type: group
        repeat: (state-get "builds.count")
        children:
          - type: group
            id: build{i}
            layout: { kind: grid, col_widths: [56, 176, 136, 80, 48, 128] }
            children:
              - text: ""
                bind: builds.res.jobs.{i}.id
              - text: ""
                bind: '(let ((n (state-get "builds.res.jobs.{i}.recipe_name"))) (if (> (string.length n) 21) (string.join (list (string.substring n 0 20) "…") "") n))'
              - text: ""
                bind: '(string.join (list (state-get "builds.res.jobs.{i}.platform") (state-get "builds.res.jobs.{i}.arch")) "/")'
              - text: ""
                bind: builds.res.jobs.{i}.status
              - text: ""
                bind: builds.res.jobs.{i}.builder_id
              - text: ""
                bind: '(string.replace (string.substring (state-get "builds.res.jobs.{i}.submitted_at") 0 16) "T" " ")'
      - separator
      - type: group
        layout: { kind: horizontal }
        visible_when: (> (int (state-get "builds.total")) (int (state-get "args.page")))
        children:
          - type: button
            label: "< Newer"
            enabled_when: (> (int (state-get "builds.offset")) 0)
            on: |
              (begin
                (state-set "builds.offset"
                  (let ((o (- (int (state-get "builds.offset")) (int (state-get "args.page"))))) (if (< o 0) 0 o)))
                (state-set "req.refresh" "1"))
          - type: button
            label: "Older >"
            enabled_when: (< (+ (int (state-get "builds.offset")) (int (state-get "builds.count"))) (int (state-get "builds.total")))
            on: |
              (begin
                (state-set "builds.offset" (+ (int (state-get "builds.offset")) (int (state-get "args.page"))))
                (state-set "req.refresh" "1"))
      - text: ""
        bind: builds.bar

  # The Activity window, as the web app's page: the filters (kind, a part of the name), Pause, and
  # the status line; "N new" while new events wait (paused, filtered or an older page); then a
  # row each: when, what happened, the package and version, the platform (build type/link), the
  # org, who and why, and a publish's size; then paging.
  activity_view:
    type: group
    children:
      - type: group
        layout: { kind: horizontal }
        children:
          - type: combo
            label: "Kind"
            bind: activity.kind
            options: [all, publish, yank, unyank, delete, nuke]
            on: (begin (state-set "activity.offset" 0) (state-set "req.refresh" "1"))
          - type: input_text
            label: "Name"
            bind: activity.name
            on: (begin (state-set "activity.offset" 0) (state-set "req.refresh" "1"))
          - type: button
            label: "Pause"
            visible_when: (!= (state-get "activity.paused") "1")
            on: (state-set "activity.paused" "1")
          - type: button
            label: "Resume"
            visible_when: (= (state-get "activity.paused") "1")
            on: (begin (state-set "activity.paused" "") (state-set "req.refresh" "1"))
          - type: button
            label: "Refresh"
            on: (state-set "req.refresh" "1")
      - type: group
        layout: { kind: horizontal }
        children:
          - text: ""
            bind: activity.status
          - type: button
            label: '(string.join (list "Show" (state-get "activity.new") "new") " ")'
            visible_when: (> (int (state-get "activity.new")) 0)
            on: |
              (begin
                (state-set "activity.offset" 0)
                (state-set "activity.paused" "")
                (state-set "req.refresh" "1"))
      - separator
      - type: group
        layout: { kind: grid, col_widths: [80, 64, 208, 216, 48, 120, 56] }
        visible_when: (> (int (state-get "activity.count")) 0)
        children:
          - text: "when"
          - text: "event"
          - text: "package"
          - text: "platform"
          - text: "org"
          - text: "by"
          - text: "size"
      - type: group
        repeat: (state-get "activity.count")
        children:
          - type: group
            id: event{i}
            layout: { kind: grid, col_widths: [80, 64, 208, 216, 48, 120, 56] }
            children:
              - text: ""
                bind: activity.rows.{i}.when
              - text: ""
                bind: activity.rows.{i}.kind
              - text: ""
                bind: activity.rows.{i}.what
              - text: ""
                bind: activity.rows.{i}.where
              - text: ""
                bind: activity.rows.{i}.org
              - text: ""
                bind: activity.rows.{i}.who
              - text: ""
                bind: activity.rows.{i}.size
      - separator
      - type: group
        layout: { kind: horizontal }
        visible_when: (> (int (state-get "activity.total")) (int (state-get "args.page")))
        children:
          - type: button
            label: "< Newer"
            enabled_when: (> (int (state-get "activity.offset")) 0)
            on: |
              (begin
                (state-set "activity.offset"
                  (let ((o (- (int (state-get "activity.offset")) (int (state-get "args.page"))))) (if (< o 0) 0 o)))
                (state-set "req.refresh" "1"))
          - type: button
            label: "Older >"
            enabled_when: (< (+ (int (state-get "activity.offset")) (int (state-get "activity.count"))) (int (state-get "activity.total")))
            on: |
              (begin
                (state-set "activity.offset" (+ (int (state-get "activity.offset")) (int (state-get "args.page"))))
                (state-set "req.refresh" "1"))
      - text: ""
        bind: activity.bar

  # The account window: who the registry says you are, and signing in and out.
  account_view:
    type: group
    children:
      - text: ""
        bind: account.status
      - type: group
        visible_when: (= (state-get "account.signed_in") "1")
        children:
          - text: "name"
            bind: account.who.name
          - text: "role"
            bind: account.who.role
          - text: "signed in with"
            bind: account.who.kind
          - text: "orgs"
            bind: account.orgs
          - type: button
            label: "Sign out"
            on: (state-set "req.signout" "1")
      - separator
      - type: group
        visible_when: (!= (state-get "account.signed_in") "1")
        children:
          - text: ""
            bind: account.pairing_note
          - type: button
            label: "Sign in with a browser"
            enabled_when: (= (state-get "account.can_pair") "1")
            on: (state-set "req.pair" "1")
          # OpenID Connect: the registry's own sign-in, in a browser, with the host keeping the
          # session (Ariadne's oidc-sign-in; a registry with cy-pca/cvcpkg#639's OAuth metadata).
          - type: button
            label: "Sign in with OIDC"
            visible_when: (= (state-get "account.can_oidc") "1")
            on: (state-set "req.oidc" "1")
          - text: "sign in at"
            bind: account.oidc_url
            visible_when: (!= (state-get "account.oidc_url") "")
          - text: "code"
            bind: account.code
            visible_when: (!= (state-get "account.code") "")
          - text: "approve at"
            bind: account.url
            visible_when: (!= (state-get "account.url") "")
          - type: button
            label: "Cancel"
            visible_when: (or (!= (state-get "account.code") "") (!= (state-get "account.oidc_url") ""))
            on: (state-set "req.cancel" "1")
          - text: "Or with an API token: cypkg --token-env VAR, where VAR holds a cvctok_ token."
      - text: ""
        bind: account.bar

  # One builder, as the web app's builder detail shows it (builder.ari): the builder, its host's
  # last report, what it builds, then its active jobs and its recent ones.
  builder_view:
    type: group
    children:
      - type: group
        layout: { kind: horizontal }
        children:
          - type: button
            label: "Refresh"
            on: (state-set "req.refresh" "1")
          - text: ""
            bind: bd.status
      - text: ""
        bind: bd.info.title
      - separator
      - type: group
        repeat: (state-get "bd.info.builder")
        children:
          - text: ""
            bind: bd.info.builder.{i}
      - separator
      - text: "Host"
        color: [0.6, 0.6, 0.6]
      - type: group
        repeat: (state-get "bd.info.host")
        children:
          - text: ""
            bind: bd.info.host.{i}
      - separator
      - type: group
        repeat: (state-get "bd.info.builds")
        children:
          - text: ""
            bind: bd.info.builds.{i}
      - separator
      - text: ""
        bind: bd.active_head
        color: [0.6, 0.6, 0.6]
      - type: group
        repeat: (state-get "bd.active")
        children:
          - text: ""
            bind: bd.active.{i}
      - text: ""
        bind: bd.recent_head
        color: [0.6, 0.6, 0.6]
      - type: group
        repeat: (state-get "bd.recent")
        children:
          - text: ""
            bind: bd.recent.{i}
      - text: ""
        bind: bd.bar

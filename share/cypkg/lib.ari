# lib.ari: cypkg's logic, as functions for main.ari's programs (transfix/libcvc#900).
#
# Pure: each takes values and returns one, reading and writing no state, so tests/lib/ tests
# each one with `ari test` and no network. main.ari imports this file; its on_tick reads state,
# calls these, and writes the results. The views can't call functions (binds run on the read
# lane), so their few formatting expressions stay inline in views.ari.

meta:
  name: cypkg-lib
  min_libcvc: 4.0.11

functions: |
  ;; ── Replies. A reply is untrusted: a field may be missing or null. ──

  ;; d's field k, or nil when d has no such field (get-attr raises).
  (defun field (d k) (try (get-attr d k) (catch (e) nil)))

  ;; v as text: nil is "", a string is itself (str would quote it), anything else is str.
  (defun text (v) (if (= v nil) "" (if (is-string v) v (str v))))

  ;; v as an int, or d when v is nil or empty (a hole that wasn't granted reads nil).
  (defun int-or (v d) (if (= (text v) "") d (int v)))

  ;; The JSON object in a 200 reply r, or nil: another status, a body that isn't JSON, or JSON
  ;; that isn't an object.
  (defun reply-object (r)
    (if (= (get-attr r "status") 200)
        (try (let ((d (json-parse (get-attr r "body")))) (if (= (type-of d) "dict") d nil))
          (catch (e) nil))
        nil))

  ;; The JSON object in reply r whatever its status (an OAuth-style error comes as a 400 with
  ;; {"error": ...}), or nil.
  (defun reply-json (r)
    (try (let ((d (json-parse (get-attr r "body")))) (if (= (type-of d) "dict") d nil))
      (catch (e) nil)))

  ;; url made absolute against server: a server may answer a path ("/link").
  (defun absolute-url (server url)
    (let ((u (text url)))
      (if (if (string.starts-with u "http://") #t (string.starts-with u "https://")) u
          (str-concat server (if (string.starts-with u "/") "" "/") u))))

  ;; d's "packages" if it is a list, else nil. d may be nil.
  (defun reply-rows (d)
    (if (= d nil) nil (let ((rows (field d "packages"))) (if (is-list rows) rows nil))))

  ;; Why reply r failed: the transport's error when nothing came back, else its HTTP status.
  (defun failure (r)
    (if (= (get-attr r "status") 0)
        (text (get-attr r "error"))
        (str-concat "HTTP " (get-attr r "status"))))

  ;; ── Search ──

  ;; A filter's value as the query sends it: "all" means no filter.
  (defun filter-value (v) (if (= v "all") "" v))

  ;; The query for one page of a search. facets is #t only for a new query or filters: it makes
  ;; the server count every match (seconds on cvcpkg.org, against a fraction of one without), and
  ;; it's the only way to get an honest package count; without it the count is page-local, so a
  ;; page reuses the first page's. sort is the results table's ("size", "-size"; cvcpkg's sort=,
  ;; cy-pca/cvcpkg#652), which the server applies to every match before it pages them; "" sends
  ;; none, for the server's own order (best match first).
  (defun search-query (q platform arch link sort page offset facets)
    (let ((d (dict "q" q "platform" (filter-value platform) "arch" (filter-value arch)
                   "link" (filter-value link) "limit" page "offset" offset
                   "facets" (if facets "true" "false"))))
      (begin
        (if (!= sort "") (set-attr d "sort" sort))
        d)))

  ;; What makes two searches the same search, paging and sort aside: a change of it is a new
  ;; search, which asks for facets. A sort or another page of the same search is not.
  (defun search-key (q platform arch link) (string.join (list q platform arch link) "|"))

  ;; The sort a search reply d was sorted by: what the server echoes, or "" when it sends none (a
  ;; registry from before sort= ignores the parameter and sends its own order).
  (defun reply-sort (d) (text (field d "sort")))

  ;; A reply's body as text (a reply's body is bytes).
  (defun body-text (r)
    (let ((b (get-attr r "body"))) (if (is-bytes b) (bytes.decode b) (text b))))

  ;; An indeterminate progress bar, width cells wide (at most 160), for the nth step of a wait: a
  ;; block that sweeps across and back. "" when n is 0 (nothing in flight). Three slices of a
  ;; constant, not a loop: a tick redraws it 20 times a second.
  (defun progress-bar (n width)
    (if (= n 0) ""
        (let ((span (- width 6)))
          (let ((pos (% n (* 2 span))))
            (let ((at (if (> pos span) (- (* 2 span) pos) pos))
                  (dots "································································································································································"))
              (str-concat (string.substring dots 0 at) "██████"
                          (string.substring dots 0 (- span at))))))))

  ;; The status line for n rows from offset off, of total, in pc packages (nil: unknown).
  (defun search-status (off n total pc)
    (if (= n 0)
        "no builds match"
        (str-concat "builds " (+ off 1) "-" (+ off n) " of " total
                    (if (= pc nil) ""
                        (str-concat ", " pc (if (= pc 1) " package" " packages"))))))

  ;; The status line when a search reply r, asked with sort, gave no rows.
  (defun search-failure (r sort)
    (if (= (get-attr r "status") 200)
        "search failed: the registry's reply was not a search result"
        (if (sort-refused r)
            (str-concat "search failed: the registry can't sort by " sort)
            (str-concat "search failed: " (failure r)))))

  ;; Whether reply r is a 422 refusing the sort (FastAPI's detail, loc ["query", "sort"]): a key
  ;; the registry doesn't sort by.
  (defun sort-refused (r)
    (if (!= (get-attr r "status") 422) #f
        (let ((d (reply-json r)))
          (let ((ds (if (= d nil) nil (field d "detail"))))
            (if (if (is-list ds) (> (length ds) 0) #f)
                (let ((loc (field (nth ds 0) "loc")))
                  (if (if (is-list loc) (= (length loc) 2) #f)
                      (if (= (nth loc 0) "query") (= (nth loc 1) "sort") #f)
                      #f))
                #f)))))

  ;; ── The search's page cache ──
  ;;
  ;; search.ari keeps the pages it has fetched in a fixed number of slots, so paging back, or a
  ;; sort seen before, shows at once with no request (a search on cvcpkg.org takes seconds).
  ;; These choose the slot. A slot is (dict "key" k "at" secs "use" n), every field present: the
  ;; page's cache-key ("" for an empty slot), when it was fetched (seconds since the epoch), and
  ;; when it was last shown (a count that only grows).

  ;; The key a page is cached under: its search (search-key: the query and filters), its sort and
  ;; its offset.
  (defun cache-key (key sort off) (str-concat key "#" sort "#" off))

  ;; Whether slot s holds a page fetched less than ttl seconds before now.
  (defun cache-live (s now ttl)
    (if (= (get-attr s "key") "") #f (< (- now (get-attr s "at")) ttl)))

  ;; The slot of slots holding page k, fetched less than ttl seconds before now, or -1.
  (defun cache-find (slots k now ttl)
    (set at -1)
    (set i 0)
    (for s slots
      (if (if (= at -1) (= (get-attr s "key") k) #f)
          (if (cache-live s now ttl) (set at i)))
      (set i (+ i 1)))
    at)

  ;; The slot page k goes in: the one holding it already, else the first empty or expired one,
  ;; else the least recently shown.
  (defun cache-slot (slots k now ttl)
    (set held -1)
    (set free -1)
    (set lru -1)
    (set least 0)
    (set i 0)
    (for s slots
      (if (if (= held -1) (= (get-attr s "key") k) #f) (set held i))
      (if (if (= free -1) (not (cache-live s now ttl)) #f) (set free i))
      (if (if (= lru -1) #t (< (get-attr s "use") least))
          (begin (set lru i) (set least (get-attr s "use"))))
      (set i (+ i 1)))
    (if (!= held -1) held (if (!= free -1) free lru)))

  ;; ── Package ──

  ;; The status line when opening package name gave no builds: rows is the reply's list (maybe
  ;; empty), or nil when the reply had none. cvcpkg.org answers an unknown name with 200 and an
  ;; empty list; another registry may send 404.
  (defun package-failure (r rows name)
    (if (if (is-list rows) #t (= (get-attr r "status") 404))
        (str-concat "no package named " name)
        (if (= (get-attr r "status") 200)
            "failed: the registry's reply was not a package"
            (str-concat "failed: " (failure r)))))

  ;; s cut to at most n characters, ending "..." when it was cut.
  (defun cut (s n)
    (if (> (string.length s) n) (str-concat (string.substring s 0 (- n 3)) "...") s))

  ;; A build's size for the table: bytes under 1 KB, else whole KB. b is a number, its text,
  ;; or "" when unknown.
  (defun size-text (b)
    (if (= (text b) "") ""
        (if (< (int b) 1024) (str-concat (text b) " B")
            (str-concat (int (/ (int b) 1024)) " KB"))))

  ;; A timestamp's date: its first 10 characters.
  (defun date-text (ts) (if (> (string.length ts) 10) (string.substring ts 0 10) ts))

  ;; One row of a package's builds table, from a build's fields as text (size may be a number):
  ;; what its cells show (version, platform, build, size_text, date), and what its columns sort
  ;; by (version, platform and build as shown; size, the bytes, a number or nil when unknown;
  ;; published, the timestamp).
  (defun build-row (version platform arch build-type link size published)
    (dict "version" version
          "platform" (str-concat platform "/" arch)
          "build" (str-concat build-type " " link)
          "size" (if (= (text size) "") nil (int size))
          "size_text" (size-text size)
          "published" published
          "date" (date-text published)))

  ;; build-row of a build as /v1/packages/{name} sends it (any field may be null).
  (defun package-row (p)
    (build-row (text (field p "version")) (text (field p "platform")) (text (field p "arch"))
               (text (field p "build_type")) (text (field p "link")) (field p "size_bytes")
               (text (field p "published_at"))))

  ;; ── A table's sort, as a type: table keeps it: "" none, "key" ascending, "-key" descending ──

  ;; The key a sort names ("size" for "-size"), and whether it runs descending.
  (defun sort-field (s) (if (string.starts-with s "-") (string.substring s 1) s))
  (defun sort-desc (s) (string.starts-with s "-"))

  ;; rows (dicts) in the order sort s names: stable, and natural (collections.sort-by: numbers by
  ;; value, "1.9" before "1.10", nil first ascending and last descending). "" keeps their order.
  (defun sort-rows (rows s)
    (if (= s "") rows (collections.sort-by rows (sort-field s) (sort-desc s))))

  ;; The elements of xs from start up to end, as a new list.
  (defun slice (xs start end)
    (set out (list))
    (set i start)
    (while (< i end)
      (set out (append out (nth xs i)))
      (set i (+ i 1)))
    out)

  ;; The page of a list of total rows to show from offset off, page rows at a time: (list
  ;; start end). An offset past the end goes back to the first page.
  (defun page-bounds (off page total)
    (let ((start (if (>= off total) 0 off)))
      (list start (if (> (+ start page) total) total (+ start page)))))

  ;; ── Waiting ──

  ;; Wait up to secs, in 0.1 s slices, for any of flags (state keys) to read "1". #t when one
  ;; did, so a module that refreshes on a timer still answers a click within a tenth of a second.
  (defun idle-wait (secs flags)
    (set k 0)
    (set hit #f)
    (while (if (not hit) (< k (* secs 10)) #f)
      (for flag flags (if (= (state-get flag) "1") (set hit #t)))
      (if (not hit) (begin (sleep 0.1) (set k (+ k 1)))))
    hit)

  ;; ── Tables ──

  ;; A timestamp as "YYYY-MM-DD HH:MM" (UTC, as the server sends it), or "" for none.
  (defun when-text (ts)
    (let ((t2 (text ts)))
      (if (< (string.length t2) 16) t2
          (str-concat (string.substring t2 0 10) " " (string.substring t2 11 5)))))

  ;; platform/arch.
  (defun where (platform arch) (str-concat (text platform) "/" (text arch)))

  ;; A builder's load, "jobs/max".
  (defun jobs-text (current max) (str-concat (text current) "/" (text max)))

  ;; Whether a window's open state (tree.<id>.open) says closed.
  (defun closed (v) (let ((t2 (text v))) (if (= t2 "0") #t (= t2 "false"))))


  ;; ── Live updates ──

  ;; The live feed of a server: ws:// for http://, wss:// for https://.
  (defun live-url (server)
    (str-concat (string.replace (string.replace (text server) "https://" "wss://") "http://" "ws://")
                "/v1/live/ws"))

  ;; Whether a feed's close code means it won't come back: 4004 (the server has no live
  ;; updates) or 4001 (it wants a token for reads).
  (defun live-final (code) (let ((c (int-or code 0))) (if (= c 4004) #t (= c 4001))))

  ;; How a window's status line says where its rows come from.
  (defun live-note (mode)
    (if (= mode "live") " · live"
        (if (= mode "connecting") " · connecting"
            (if (= mode "offline") " · polling" ""))))

  ;; The hello a feed starts with: the topics it wants (a list of strings).
  (defun hello-text (topics) (json-encode (dict "type" "hello" "topics" topics)))

  ;; The fields of a builder the Builders window shows. Its capabilities stay behind: their keys
  ;; ("glibc2.35") can't name state nodes.
  (defun builder-row (b)
    (dict "id" (field b "id") "name" (text (field b "name")) "platform" (text (field b "platform"))
          "arch" (text (field b "arch")) "status" (text (field b "status"))
          "current_jobs" (field b "current_jobs") "max_jobs" (field b "max_jobs")
          "version" (text (field b "version")) "last_heartbeat" (text (field b "last_heartbeat"))))

  ;; builder-row of each of `rows`.
  (defun builder-rows (rows)
    (set out (list))
    (for b rows (set out (append out (builder-row b))))
    out)


  ;; ── Time, as the web app shows it: how long ago ──

  ;; a // b for whole a, b >= 0.
  (defun idiv (a b) (int (/ (float a) (float b))))

  ;; Days from 1970-01-01 to the date y-m-d (the proleptic Gregorian calendar, y >= 1970).
  (defun epoch-days (y m d)
    (let ((yy (if (<= m 2) (- y 1) y)))
      (let ((era (idiv yy 400)))
        (let ((yoe (- yy (* era 400)))
              (mp (if (> m 2) (- m 3) (+ m 9))))
          (let ((doy (+ (idiv (+ (* 153 mp) 2) 5) (- d 1))))
            (- (+ (* era 146097) (* yoe 365) (idiv yoe 4) doy) (idiv yoe 100) 719468))))))

  ;; A timestamp as the server sends it ("2026-11-26T09:11:29.88Z", UTC) in seconds since the
  ;; Unix epoch, or nil when it isn't one.
  (defun iso-epoch (ts)
    (let ((s (text ts)))
      (if (< (string.length s) 19) nil
          (try
            (+ (* 86400 (epoch-days (int (string.substring s 0 4)) (int (string.substring s 5 2))
                                    (int (string.substring s 8 2))))
               (* 3600 (int (string.substring s 11 2))) (* 60 (int (string.substring s 14 2)))
               (int (string.substring s 17 2)))
            (catch (e) nil)))))

  ;; How long ago `secs` seconds is: "just now", "12 s ago", "5 min ago", "3 h ago", "2 d ago".
  (defun ago-text (secs)
    (let ((s (int secs)))
      (if (< s 1) "just now"
          (if (< s 60) (str-concat s " s ago")
              (if (< s 3600) (str-concat (idiv s 60) " min ago")
                  (if (< s 86400) (str-concat (idiv s 3600) " h ago")
                      (str-concat (idiv s 86400) " d ago")))))))

  ;; How long ago timestamp ts was, seen at `now` (seconds since the epoch), or the timestamp
  ;; itself when it can't be read.
  (defun ago (ts now)
    (let ((t0 (iso-epoch ts)))
      (if (= t0 nil) (when-text ts) (ago-text (- now t0)))))

  ;; A span of seconds as days and hours ("10 d 6 h"), hours and minutes, or minutes.
  (defun span-text (secs)
    (let ((s (int (float (text-or-0 secs)))))
      (if (>= s 86400) (str-concat (idiv s 86400) " d " (idiv (- s (* 86400 (idiv s 86400))) 3600) " h")
          (if (>= s 3600) (str-concat (idiv s 3600) " h " (idiv (- s (* 3600 (idiv s 3600))) 60) " min")
              (str-concat (idiv s 60) " min")))))
  (defun text-or-0 (v) (if (= (text v) "") "0" (text v)))


  ;; ── A builder, as the web app's card and detail show it ──

  ;; A meter `width` cells wide, full to the fraction f (0 to 1): ▕████░░░░▏.
  (defun meter (f width)
    (let ((n (int (+ 0.5 (* width (if (< f 0) 0 (if (> f 1) 1 f)))))))
      (begin
        (set out "")
        (set i 0)
        (while (< i width) (begin (set out (str-concat out (if (< i n) "█" "░"))) (set i (+ i 1))))
        (str-concat "▕" out "▏"))))

  ;; A count of bytes as GB with one decimal ("31.2 GB").
  (defun gb-text (b)
    (let ((g (/ (float (text-or-0 b)) 1073741824.0)))
      (str-concat (int g) "." (int (* 10 (- g (int g)))) " GB")))

  ;; A fraction as a whole percentage ("28%").
  (defun pct-text (f) (str-concat (int (+ 0.5 (* 100 f))) "%"))

  ;; The fraction used of a total, from what's left: 1 - left/total, or 0 without a total.
  (defun used (left total)
    (let ((t1 (float (text-or-0 total))))
      (if (<= t1 0) 0 (- 1 (/ (float (text-or-0 left)) t1)))))

  ;; A list as text, ", " between, or "—" when empty or not a list.
  (defun list-text (xs)
    (if (is-list xs)
        (if (= (length xs) 0) "—" (string.join (collections.map xs text) ", "))
        "—"))

  ;; What a builder builds beyond its own platform (its capabilities' cross_platforms, as
  ;; "wasm/wasm32, wasi/wasm32"), and the flags it has (its true keys: "glibc2.35, incus").
  (defun cross-text (caps)
    (let ((xs (field caps "cross_platforms")))
      (if (is-list xs)
          (list-text (collections.map xs (lambda (x) (where (field x "platform") (field x "arch")))))
          "—")))
  (defun flags-text (caps)
    (try
      (list-text (collections.filter (collections.dict-keys caps)
                   (lambda (k) (= (get-attr caps k) #t))))
      (catch (e) "—")))

  (defun org-text (b) (if (= (text (field b "org_slug")) "") "—" (text (field b "org_slug"))))
  (defun cpu-of (sys) (/ (float (text-or-0 (field sys "cpu_percent"))) 100.0))

  ;; A builder as a card, seen at `now`: the lines the Builders window draws (head, load, seen),
  ;; and its status, which colours the head (online, busy, offline).
  (defun builder-card (b now)
    (let ((sys (field b "system")))
      (let ((cpu (cpu-of sys))
            (mem (used (field sys "mem_available_bytes") (field sys "mem_total_bytes")))
            (disk (used (field sys "disk_free_bytes") (field sys "disk_total_bytes"))))
        (dict "id" (field b "id") "name" (text (field b "name")) "status" (text (field b "status"))
              ;; the heartbeat as sent, and the seen line's tail: the window ages the line
              ;; (seen-text) every few seconds, between the feed's messages
              "hb" (text (field b "last_heartbeat"))
              "seen_tail" (str-concat "  ·  org " (org-text b) "  ·  " (list-text (field b "labels")))
              "head" (str-concat (cut (text (field b "name")) 22) "  " (text (field b "status")) "  "
                                 (where (field b "platform") (field b "arch"))
                                 (if (= (text (field b "version")) "") ""
                                     (str-concat "  v" (text (field b "version")))))
              "load" (str-concat "jobs " (jobs-text (field b "current_jobs") (field b "max_jobs"))
                                 (if (= sys nil) "  ·  no host report"
                                     (str-concat "  cpu " (meter cpu 6) " " (pct-text cpu)
                                                 "  mem " (meter mem 6) " " (pct-text mem)
                                                 "  disk " (meter disk 6) " " (pct-text disk))))
              "seen" (str-concat "heartbeat " (ago (field b "last_heartbeat") now)
                                 "  ·  org " (org-text b) "  ·  " (list-text (field b "labels")))))))

  ;; A card's seen line again, at `now`, from its hb and seen_tail.
  (defun seen-text (hb tail now) (str-concat "heartbeat " (ago hb now) tail))

  ;; builder-card of each of `rows`.
  (defun builder-cards (rows now)
    (set out (list))
    (for b rows (set out (append out (builder-card b now))))
    out)

  ;; A builder's detail, seen at `now`: a title, and lines in three groups: the builder, its
  ;; host (its last report), and what it builds.
  (defun builder-detail (b now)
    (let ((sys (field b "system")) (caps (field b "capabilities")))
      (dict
        "title" (str-concat (text (field b "name")) "  ·  " (text (field b "status")))
        "builder" (list
          (str-concat "id " (text (field b "id")) "  ·  version " (text (field b "version"))
                      "  ·  " (where (field b "platform") (field b "arch")))
          (str-concat "jobs " (jobs-text (field b "current_jobs") (field b "max_jobs"))
                      "  ·  heartbeat " (ago (field b "last_heartbeat") now))
          (str-concat "org " (org-text b) "  ·  serves " (list-text (field b "served_namespaces"))
                      "  ·  affinity " (if (= (field b "prefer_affinity") #t) "yes" "no"))
          (str-concat "registered " (when-text (field b "created_at"))
                      (if (= (text (field b "registered_by")) "") ""
                          (str-concat " by " (text (field b "registered_by"))))))
        "host" (if (= sys nil) (list "no host report yet")
                 (list
                   (str-concat "cpu " (text (field sys "cpu_count")) " cores, "
                               (pct-text (cpu-of sys)) " busy  ·  load " (list-text (field sys "load_avg")))
                   (str-concat "memory " (gb-text (field sys "mem_available_bytes")) " free of "
                               (gb-text (field sys "mem_total_bytes")))
                   (str-concat "disk " (gb-text (field sys "disk_free_bytes")) " free of "
                               (gb-text (field sys "disk_total_bytes")))
                   (str-concat (text (field sys "os")) "  ·  Python " (text (field sys "python")))
                   (str-concat "up " (span-text (field sys "uptime_seconds"))
                               "  ·  agent up " (span-text (field sys "agent_uptime_seconds")))))
        "builds" (list
                   (str-concat "labels " (list-text (field b "labels")))
                   (str-concat "cross " (cross-text caps))
                   (str-concat "flags " (flags-text caps))))))

  ;; A job as a line of the detail's lists: #id, status, recipe and version, how long it ran
  ;; (or has run), and when it was submitted, seen at `now`.
  (defun job-row (j now)
    (let ((t0 (iso-epoch (field j "started_at"))) (t1 (iso-epoch (field j "finished_at"))))
      (str-concat "#" (text (field j "id")) "  " (text (field j "status")) "  "
                  (cut (str-concat (text (field j "recipe_name")) " " (text (field j "recipe_version"))) 34)
                  (if (= t0 nil) "" (str-concat "  " (span-text (- (if (= t1 nil) now t1) t0))))
                  "  " (ago (field j "submitted_at") now))))


  ;; ── Activity, as the web app's page shows it ──

  ;; An event (/v1/activity, or the feed's activity message) as a row, seen at `now`: when (how
  ;; long ago; at is the timestamp, for aging), what happened, to which package and version, for
  ;; which platform (with its link, and "debug" for a debug build), in which org, by whom and
  ;; why, and how big (a publish's size). Whole: the window's table cuts each to its column, which
  ;; the user can widen.
  (defun event-row (e now)
    (let ((bt (text (field e "build_type"))) (ln (text (field e "link"))))
      (dict "id" (field e "id") "at" (text (field e "created_at"))
            "when" (ago (field e "created_at") now)
            "kind" (text (field e "kind"))
            "what" (str-concat (text (field e "name")) " " (text (field e "version")))
            "where" (str-concat (where (field e "platform") (field e "arch"))
                                (if (= ln "") "" (str-concat " " ln))
                                (if (= bt "debug") " debug" ""))
            "org" (if (= (text (field e "org_slug")) "") "—" (text (field e "org_slug")))
            "who" (str-concat (text (field e "actor"))
                              (if (= (text (field e "detail")) "") ""
                                  (str-concat " · " (text (field e "detail")))))
            "size" (if (= (text (field e "kind")) "publish") (size-text (field e "size_bytes")) ""))))

  ;; event-row of each of `rows`.
  (defun event-rows (rows now)
    (collections.map rows (lambda (e) (event-row e now))))

  ;; Whether event e passes the filters: kind ("all" or one kind) and name (a part of it, any
  ;; case; "" for any).
  (defun event-matches (e kind name)
    (and (if (= kind "all") #t (= (text (field e "kind")) kind))
         (if (= name "") #t (string.contains (string.lower (text (field e "name"))) (string.lower name)))))

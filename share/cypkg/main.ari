# cypkg — a client for cvcpkg registries.
#
# This is the app: its arguments, and the client itself, cypkg.ari, loaded as one component (which
# any other document can load the same way; see the top of cypkg.ari). The same document runs in
# stock hosts, unmodified. The launcher (bin/cypkg) runs it with the network allowed to the
# registry and nothing else:
#
#   ari run --net-allow https://cvcpkg.org share/cypkg/main.ari --server https://cvcpkg.org
#
# The component's menu is named by the registry it browses ("cvcpkg.org"), as nicotina names each
# site's menu by its host.

meta:
  name: cypkg
  version: 0.2.0
  description: A cvcpkg registry client
  min_libcvc: 4.0.11

requires:
  - net
  - json-parse
  - state-set-tree

args:
  server: {type: string, default: "https://cvcpkg.org", help: The registry to browse}
  q: {type: string, default: "", help: Search for this at start}
  package: {type: string, default: "", help: Open this package at start}
  platform: {type: string, default: all, help: "Only builds for this platform (all, linux, macos, windows, ...)"}
  arch: {type: string, default: all, help: "Only builds for this architecture (all, x86_64, arm64, ...)"}
  link: {type: string, default: all, help: "Only shared or static builds (all, shared, static)"}
  offset: {type: int, default: 0, help: The first search row to show}
  pkg-offset: {type: int, default: 0, help: The first build of the opened package to show}
  sort: {type: string, default: "", help: "Sort the search at start by name, version, platform, link or size (the columns), or arch, build_type, published or org; -size for descending"}
  pkg-sort: {type: string, default: "", help: "Sort a package's builds by version, platform, build, size or published; -size for descending"}
  page: {type: int, default: 10, help: Rows per page}
  open: {type: string, default: "", help: "Windows to open at start, comma-separated: builders, builds, activity, account"}
  progress: {type: string, default: "on", help: "off: wait for replies without a progress bar (the browser build passes it)"}
  live: {type: string, default: "on", help: "off: poll the builders, builds and activity windows instead of following the live feed"}
  builder: {type: string, default: "", help: "Open this builder's window at start (its id)"}
  now: {type: string, default: "", help: "Pin the clock at this time (2026-11-26T09:00:00Z) for \"12 s ago\": for tests"}

# A bar of the host's own: Quit leaves cypkg. The component's menu follows it.
menubar:
  - menu: cypkg
    items:
      - menu_item: Quit
        on: quit

windows:
  - load: cypkg.ari
    as: cypkg
    # the registry's host: https://cvcpkg.org -> cvcpkg.org (a plain expression: a load's name:
    # is worked out without the document's functions)
    name: (string.replace (string.replace (state-get "args.server") "https://" "") "http://" "")
    link:
      args: { to: args, mode: ro }

# cypkg — a terminal client for cvcpkg registries.
#
# M0: anonymous, read-only browsing. Search the catalog with the web page's filters, and open a
# package to see its builds and its install line. The launcher (bin/cypkg) runs this in stock ari
# with the network allowed to the registry and nothing else:
#
#   ari run --net-allow https://cvcpkg.org share/cypkg/main.ari --server https://cvcpkg.org
#
# Requests run in on_tick, the action lane. Widgets only set a request flag (req.search) or name a
# package to open (pkg.want); on_tick sends the request and writes the parsed reply into the state
# tree with state-set-tree, where the rows bind to it. search.seq and pkg.seq count the requests
# that have finished, so tests/logic.tests.yaml can wait for one.

meta:
  name: cypkg
  version: 0.1.0
  description: Browse a cvcpkg registry in the terminal
  min_libcvc: 3.7.4

import: views.ari

requires:
  - net
  - json-parse
  - state-set-tree

args:
  server: {type: string, default: "https://cvcpkg.org", help: The registry to browse}
  q: {type: string, default: "", help: Search for this at start}
  package: {type: string, default: "", help: Open this package at start}
  platform: {type: string, default: all, help: "Only builds for this platform (all, linux, macos, windows, ...)"}
  arch: {type: string, default: all, help: "Only builds for this architecture (all, x86_64, arm64, ...)"}
  link: {type: string, default: all, help: "Only shared or static builds (all, shared, static)"}
  offset: {type: int, default: 0, help: The first search row to show}
  pkg-offset: {type: int, default: 0, help: The first build of the opened package to show}
  page: {type: int, default: 10, help: Rows per page}

init: |
  (begin
    (state-set "view" "search")
    (state-set "app.started" "")
    (state-set "search.q" (state-get "args.q"))
    (state-set "search.platform" (state-get "args.platform"))
    (state-set "search.arch" (state-get "args.arch"))
    (state-set "search.link" (state-get "args.link"))
    (state-set "search.offset" (int (state-get "args.offset")))
    (state-set "search.count" 0)
    (state-set "search.total" 0)
    (state-set "search.status" "")
    (state-set "search.sent" "")
    (state-set "search.seq" 0)
    (state-set "pkg.seq" 0)
    (state-set "req.search" "0")
    (state-set "req.pkgpage" "0")
    (state-set "pkg.want" "")
    (state-set "pkg.name" "")
    (state-set "pkg.offset" 0)
    (state-set "pkg.start" 0)
    (state-set "pkg.count" 0)
    (state-set "pkg.total" 0)
    (state-set "pkg.status" ""))

on_tick: |
  (begin
    ;; Helpers for this program. A reply is untrusted: a field may be missing or null.
    (defun field (d k) (try (get-attr d k) (catch (e) nil)))
    (defun text (v) (if (= v nil) "" (if (is-string v) v (str v))))
    (defun failure (r)
      (if (= (get-attr r "status") 0)
          (text (get-attr r "error"))
          (str-concat "HTTP " (get-attr r "status"))))
    ;; The reply's JSON object, or nil when the body isn't one.
    (defun parse (r)
      (try (let ((d (json-parse (get-attr r "body")))) (if (= (type-of d) "dict") d nil))
        (catch (e) nil)))

    (if (= (state-get "app.started") "")
        (begin
          (state-set "app.started" "1")
          (state-set "req.search" "1")
          (if (!= (state-get "args.package") "")
              (begin
                (state-set "pkg.start" (int (state-get "args.pkg-offset")))
                (state-set "pkg.want" (state-get "args.package"))))))

    ;; A filter changed since the last search: search again from the first row. (A combo's on: is
    ;; dropped by libcvc today, so the combos can't ask for it themselves.)
    (set filters (str-concat (state-get "search.platform") "|" (state-get "search.arch") "|"
                             (state-get "search.link")))
    (if (!= filters (state-get "search.sent"))
        (begin
          (if (!= (state-get "search.sent") "") (state-set "search.offset" 0))
          (state-set "search.sent" filters)
          (state-set "req.search" "1")))

    ;; A search: the filters as the web page sends them, one page of rows. facets=true, as the web
    ;; page sends it: without it the server counts packages on the returned page only.
    (if (= (state-get "req.search") "1")
        (begin
          (state-set "req.search" "0")
          (state-set "search.status" "searching...")
          (set any (lambda (k) (if (= (state-get k) "all") "" (state-get k))))
          (set r (http-get (str-concat (state-get "args.server") "/v1/search")
                   (dict "query" (dict "q" (state-get "search.q")
                                       "platform" (any "search.platform")
                                       "arch" (any "search.arch")
                                       "link" (any "search.link")
                                       "limit" (state-get "args.page")
                                       "offset" (state-get "search.offset")
                                       "facets" "true"))))
          (set d (if (= (get-attr r "status") 200) (parse r) nil))
          (set rows (if (= d nil) nil (field d "packages")))
          (if (is-list rows)
              (begin
                (state-set-tree "search.res" d)
                (set n (length rows))
                (set off (int (state-get "search.offset")))
                (set total (if (= (field d "total") nil) n (int (field d "total"))))
                (set pc (field d "package_count"))
                (state-set "search.count" n)
                (state-set "search.total" total)
                (state-set "search.status"
                  (if (= n 0)
                      "no builds match"
                      (str-concat "builds " (+ off 1) "-" (+ off n) " of " total
                                  (if (= pc nil) ""
                                      (str-concat ", " pc (if (= pc 1) " package" " packages")))))))
              (begin
                (state-set "search.count" 0)
                (state-set "search.total" 0)
                (state-set "search.status"
                  (if (= (get-attr r "status") 200)
                      "search failed: the registry's reply was not a search result"
                      (str-concat "search failed: " (failure r))))))
          (state-set "search.seq" (+ (int (state-get "search.seq")) 1))))

    ;; Open a package: every build of it, shown a page at a time.
    (if (!= (state-get "pkg.want") "")
        (begin
          (set name (state-get "pkg.want"))
          (state-set "pkg.want" "")
          (state-set "pkg.name" name)
          (state-set "pkg.offset" (state-get "pkg.start"))
          (state-set "pkg.start" 0)
          (state-set "pkg.count" 0)
          (state-set "pkg.total" 0)
          (state-set "pkg.status" "loading...")
          (state-set "view" "package")
          (set r (http-get (str-concat (state-get "args.server") "/v1/packages/"
                                       (url-encode name))))
          (set d (if (= (get-attr r "status") 200) (parse r) nil))
          (set rows (if (= d nil) nil (field d "packages")))
          (if (if (is-list rows) (> (length rows) 0) #f)
              (begin
                (state-set-tree "pkg.all" rows)
                (set p (nth rows 0))
                (set desc (text (field p "description")))
                (state-set "pkg.desc"
                  (if (> (string.length desc) 92) (str-concat (string.substring desc 0 89) "...") desc))
                (state-set "pkg.version" (text (field p "version")))
                (state-set "pkg.license" (text (field p "license")))
                (state-set "pkg.homepage" (text (field p "homepage")))
                (state-set "pkg.tags" (text (field p "tags")))
                (state-set "pkg.install" (str-concat "cvcpkg install " name))
                (state-set "pkg.total" (length rows))
                (state-set "req.pkgpage" "1"))
              (state-set "pkg.status"
                (if (is-list rows)
                    (str-concat "no package named " name)
                    (if (= (get-attr r "status") 404)
                        (str-concat "no package named " name)
                        (if (= (get-attr r "status") 200)
                            "failed: the registry's reply was not a package"
                            (str-concat "failed: " (failure r)))))))
          (if (= (state-get "req.pkgpage") "0")
              (state-set "pkg.seq" (+ (int (state-get "pkg.seq")) 1)))))

    ;; One page of the open package's builds, from the reply already held.
    (if (= (state-get "req.pkgpage") "1")
        (begin
          (state-set "req.pkgpage" "0")
          (set total (int (state-get "pkg.total")))
          (set off (int (state-get "pkg.offset")))
          (if (>= off total) (set off 0))
          (state-set "pkg.offset" off)
          (set end (+ off (int (state-get "args.page"))))
          (if (> end total) (set end total))
          (set at (lambda (i k) (text (state-get (str-concat "pkg.all." i "." k)))))
          (set rows (list))
          (set i off)
          (while (< i end)
            (set size (at i "size_bytes"))
            (set rows (append rows (dict
              "version" (at i "version")
              "where" (str-concat (at i "platform") "/" (at i "arch"))
              "kind" (str-concat (at i "build_type") " " (at i "link"))
              "size" (if (= size "") ""
                         (if (< (int size) 1024) (str-concat size " B")
                             (str-concat (int (/ (int size) 1024)) " KB")))
              "date" (let ((ts (at i "published_at")))
                       (if (> (string.length ts) 10) (string.substring ts 0 10) ts)))))
            (set i (+ i 1)))
          (state-set-tree "pkg.page" rows)
          (state-set "pkg.count" (- end off))
          (state-set "pkg.status" (str-concat "builds " (+ off 1) "-" end " of " total))
          (state-set "pkg.seq" (+ (int (state-get "pkg.seq")) 1)))))

windows:
  - window: cypkg
    id: main
    pos: [0, 0]
    size: [800, 464]
    children:
      - text: "registry"
        bind: args.server

      # The views: units from views.ari.
      - include: search_view
      - include: package_view

# search.ari: the search module.
#
# The query and filters, one page of build rows, and the pager. Its on_tick runs the searches.
#
# A module: main.ari mounts it with load:. It owns its state (its chroot is includes.<as> in the
# parent) and reaches the parent only through the holes main.ari grants:
#   args   read-only: the command line (server, page, and the start-up search)
#   view   which view shows: "search" or "package"
#   nav    nav.open, the package to open, and nav.start, its first build
# It imports its own view (views.ari) and logic (lib.ari). A hidden mount doesn't run until it is
# first shown; after that its on_tick keeps running.

meta:
  name: cypkg-search
  min_libcvc: 3.7.4

needs: [args, view, nav, auth]

import: [views.ari, lib.ari, net.ari]

init: |
  (begin
    (state-set "search.q" (text (state-get "args.q")))
    (state-set "search.platform" (if (= (text (state-get "args.platform")) "") "all" (state-get "args.platform")))
    (state-set "search.arch" (if (= (text (state-get "args.arch")) "") "all" (state-get "args.arch")))
    (state-set "search.link" (if (= (text (state-get "args.link")) "") "all" (state-get "args.link")))
    (state-set "search.offset" (int-or (state-get "args.offset") 0))
    (state-set "search.count" 0)
    (state-set "search.total" 0)
    (state-set "search.status" "")
    (state-set "search.sent" "")
    (state-set "search.seq" 0)
    (state-set "search.key" "")
    (state-set "search.pc" "")
    (state-set "search.busy" 0)
    (state-set "search.bar" "")
    (state-set "search.next.key" "")
    (state-set "search.prev.key" "")
    (state-set "req.search" "1"))

# search.seq counts the searches that have finished, so a test can wait for one.
on_tick: |
  (begin
    ;; A filter changed since the last search: search again from the first row. (A combo's on: is
    ;; dropped by libcvc today, so the combos can't ask for it themselves.)
    (set filters (str-concat (state-get "search.platform") "|" (state-get "search.arch") "|"
                             (state-get "search.link")))
    (if (!= filters (state-get "search.sent"))
        (begin
          (if (!= (state-get "search.sent") "") (state-set "search.offset" 0))
          (state-set "search.sent" filters)
          (state-set "req.search" "1")))

    (set url (str-concat (state-get "args.server") "/v1/search"))
    (set page (int-or (state-get "args.page") 10))
    (set key (search-key (state-get "search.q") (state-get "search.platform")
                         (state-get "search.arch") (state-get "search.link")))
    ;; A page kept in slot (next or prev) for this search at offset off, as reply text, or nil.
    (defun kept (slot off)
      (if (if (= (state-get (str-concat "search." slot ".key")) key)
              (= (int-or (state-get (str-concat "search." slot ".offset")) -1) off) #f)
          (state-get (str-concat "search." slot ".body"))
          nil))
    (defun keep (slot off body)
      (state-set (str-concat "search." slot ".key") key)
      (state-set (str-concat "search." slot ".offset") off)
      (state-set (str-concat "search." slot ".body") body))

    ;; A search: one page of rows. A new query or filter asks the server for facets (the honest
    ;; package count); paging doesn't, and reuses that count. A page already fetched (the next
    ;; one, prefetched, or the one just left) is parsed from its text with no request.
    (if (= (state-get "req.search") "1")
        (begin
          (state-set "req.search" "0")
          (set off (int (state-get "search.offset")))
          (set fresh (!= key (state-get "search.key")))
          (set body (if fresh nil (kept "next" off)))
          (if (= body nil) (set body (if fresh nil (kept "prev" off))))
          (set r (if (= body nil)
                     (begin
                       (state-set "search.status" "searching...")
                       (fetch url (with-auth (dict "query"
                                    (search-query (state-get "search.q") (state-get "search.platform")
                                                  (state-get "search.arch") (state-get "search.link")
                                                  page off fresh)))
                              "search"))
                     (dict "status" 200 "body" body "error" "")))
          (set d (reply-object r))
          (set rows (reply-rows d))
          (if (is-list rows)
              (begin
                ;; The page being left stays at hand for Prev.
                (if (if (not fresh) (!= (state-get "search.key") "") #f)
                    (keep "prev" (int (state-get "search.shown")) (state-get "search.body")))
                (state-set-tree "search.res" d)
                (state-set "search.body" (body-text r))
                (state-set "search.shown" off)
                (state-set "search.key" key)
                (if fresh (state-set "search.pc" (text (field d "package_count"))))
                (set n (length rows))
                (set total (if (= (field d "total") nil) n (int (field d "total"))))
                (state-set "search.count" n)
                (state-set "search.total" total)
                (state-set "search.status"
                  (search-status off n total (if (= (state-get "search.pc") "") nil
                                                 (int (state-get "search.pc"))))))
              (begin
                (state-set "search.key" "")
                (state-set "search.count" 0)
                (state-set "search.total" 0)
                (state-set "search.status" (search-failure r))))
          (state-set "search.seq" (+ (int (state-get "search.seq")) 1))

          ;; Prefetch the next page in the background, so Next is instant. A failure is left for
          ;; the click to find.
          ;; Not with --progress off (the browser build), where an async request can hang.
          (if (if (is-list rows)
                  (if (< (+ off page) (int (state-get "search.total")))
                      (!= (text (state-get "args.progress")) "off") #f) #f)
              (if (= (kept "next" (+ off page)) nil)
                  (begin
                    (set nf (http-get-async url (dict "query"
                              (search-query (state-get "search.q") (state-get "search.platform")
                                            (state-get "search.arch") (state-get "search.link")
                                            page (+ off page) #f))))
                    (set nr (await nf))
                    (if (= (get-attr nr "status") 200)
                        (keep "next" (+ off page) (body-text nr)))))))))

root:
  - include: search_view

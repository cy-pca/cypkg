# builders.ari: the builder fleet: name, platform, status, load, version, last heartbeat.
#
# A module mounted in its own window by main.ari, through the holes args (read-only), shown (its
# window's tree.<id>.open, read-only) and auth. A closed window's module doesn't start until the
# window is first opened.
#
# While the window is open it follows the registry's live feed (the builders topic): the server
# sends the whole fleet, then each builder as it changes, and the rows change in place. Without a
# feed it polls /v1/builders about every 10 s, and tries the feed again.

meta:
  name: cypkg-builders
  min_libcvc: 3.7.4

needs: [args, shown, auth]

import: [views.ari, lib.ari, net.ari]

functions: |
  ;; Show `rows` (a list of builders) as the whole fleet.
  (defun show-builders (rows)
    (state-set-tree "builders.res" (dict "builders" (builder-rows rows)))
    (state-set "builders.count" (length rows))
    (count-online))

  ;; Put builder `b` in its row, by id, or at the end when it's new.
  (defun put-builder (b)
    (set n (int (state-get "builders.count")))
    (set id (text (field b "id")))
    (set at -1)
    (set i 0)
    (while (if (< i n) (= at -1) #f)
      (if (= (text (state-get (str-concat "builders.res.builders." i ".id"))) id) (set at i))
      (set i (+ i 1)))
    (if (= at -1)
        (begin (set at n) (state-set "builders.count" (+ n 1))))
    (state-set-tree (str-concat "builders.res.builders." at) (builder-row b))
    (count-online))

  (defun count-online ()
    (set n (int (state-get "builders.count")))
    (set online 0)
    (set i 0)
    (while (< i n)
      (if (= (state-get (str-concat "builders.res.builders." i ".status")) "online")
          (set online (+ online 1)))
      (set i (+ i 1)))
    (state-set "builders.base" (str-concat online " of " n " online")))

init: |
  (begin
    (state-set "builders.count" 0)
    (state-set "builders.status" "")
    (state-set "builders.busy" 0)
    (state-set "builders.bar" "")
    (state-set "builders.seq" 0)
    (live-init "builders")
    (state-set "req.refresh" "1"))

on_tick: |
  (begin
    (if (closed (state-get "shown"))
        (begin
          (live-stop "builders")
          (state-set "builders.retry" "1"))
        (begin
          (set msgs (live-pump "builders" (list "builders") (= (state-get "builders.retry") "1")))
          (state-set "builders.retry" "0")
          (for m msgs
            (set ty (field m "type"))
            (if (= ty "builders") (show-builders (field m "builders")))
            (if (= ty "builder") (put-builder (field m "builder")))
            (if (= ty "builder_removed") (state-set "req.refresh" "1"))
            (if (= ty "resync") (state-set "req.refresh" "1")))
          (if (> (length msgs) 0)
              (state-set "builders.seq" (+ (int (state-get "builders.seq")) 1)))))

    (if (= (state-get "req.refresh") "1")
        (begin
          (state-set "req.refresh" "0")
          (set r (fetch (str-concat (state-get "args.server") "/v1/builders") (with-auth (dict))
                        "builders"))
          (set d (reply-object r))
          (set rows (if (= d nil) nil (field d "builders")))
          (if (is-list rows)
              (show-builders rows)
              (begin
                (state-set "builders.count" 0)
                (state-set "builders.base" (str-concat "failed: " (failure r)))))
          (state-set "builders.seq" (+ (int (state-get "builders.seq")) 1))))

    (live-status "builders")
    ;; No feed: poll about every 10 s while the window is open. A click is answered at once.
    (if (live-idle "builders")
        (if (not (closed (state-get "shown"))) (state-set "req.refresh" "1"))))

root:
  - include: builders_view

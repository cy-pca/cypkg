# package_failed: a failed load
#
# No builds: only Back, the name and the status show.
# A view unit test: it includes the unit from share/cypkg/views.ari over state seeded here, with no
# network. tests/unit.sh renders it with ari snapshot and compares tests/unit/expected/.

meta:
  name: unit-package_failed
  min_libcvc: 3.7.4

import: ../../share/cypkg/views.ari

args:
  page: {type: int, default: 10}

init: |
  (begin
    (state-set "view" "package")
    (state-set "pkg.name" "zlib")
    (state-set "pkg.count" 0)
    (state-set "pkg.offset" 0)
    (state-set "pkg.total" 0)
    (state-set "pkg.status" "failed: HTTP 500"))

windows:
  - window: test
    id: main
    pos: [0, 0]
    size: [800, 464]
    children:
      - include: package_view

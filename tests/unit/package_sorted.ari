# package_sorted: a package's builds sorted by a column
#
# The builds table sorted by version, ascending (pkg.sort "version"): its header shows the
# direction. The module sorts the rows (lib.ari's sort-rows); here they are seeded in that order.
# A view unit test: it includes the unit from share/cypkg/views.ari over state seeded here, with no
# network. tests/unit.sh renders it with ari snapshot and compares tests/unit/expected/.

meta:
  name: unit-package_sorted
  min_libcvc: 4.0.10

import: ../../share/cypkg/views.ari

args:
  page: {type: int, default: 10}

init: |
  (begin
    (state-set "view" "package")
    (state-set "pkg.name" "zstd")
    (state-set "pkg.desc" "Zstandard, a fast lossless compression algorithm.")
    (state-set "pkg.version" "1.5.10+cvc.1")
    (state-set "pkg.license" "BSD-3-Clause")
    (state-set "pkg.homepage" "https://facebook.github.io/zstd/")
    (state-set "pkg.tags" "compression")
    (state-set "pkg.install" "cvcpkg install zstd")
    (state-set "pkg.sort" "version")
    (state-set-tree "pkg.page" (list
      (dict "version" "1.5.9+cvc.2" "platform" "linux/x86_64" "build" "release shared" "size_text" "511 KB" "date" "2026-09-20")
      (dict "version" "1.5.10+cvc.1" "platform" "macos/arm64" "build" "release static" "size_text" "498 KB" "date" "2026-10-01")
      (dict "version" "1.5.10+cvc.1" "platform" "windows/x86_64" "build" "debug shared" "size_text" "2048 KB" "date" "2026-10-02")))
    (state-set "pkg.count" 3)
    (state-set "pkg.offset" 0)
    (state-set "pkg.total" 3)
    (state-set "pkg.status" "builds 1-3 of 3"))

windows:
  - window: test
    id: main
    pos: [0, 0]
    size: [800, 464]
    children:
      - include: package_view

# package_details: a package page
#
# A package's details and two builds, with more pages after them.
# A view unit test: it includes the unit from share/cypkg/views.ari over state seeded here, with no
# network. tests/unit.sh renders it with ari snapshot and compares tests/unit/expected/.

meta:
  name: unit-package_details
  min_libcvc: 3.7.4

import: ../../share/cypkg/views.ari

args:
  page: {type: int, default: 10}

init: |
  (begin
    (state-set "view" "package")
    (state-set "pkg.name" "zlib")
    (state-set "pkg.desc" "zlib — a general-purpose lossless data compression library.")
    (state-set "pkg.version" "1.3.1+cvc.5")
    (state-set "pkg.license" "Zlib")
    (state-set "pkg.homepage" "https://zlib.net/")
    (state-set "pkg.tags" "wasi,utils,io,wasm")
    (state-set "pkg.install" "cvcpkg install zlib")
    (state-set-tree "pkg.page" (list
      (dict "version" "1.3.1+cvc.5" "where" "linux/x86_64" "kind" "release shared" "size" "160 KB" "date" "2026-09-26")
      (dict "version" "1.3.1+cvc.5" "where" "wasm/wasm32" "kind" "release static" "size" "77 KB" "date" "2026-09-23")))
    (state-set "pkg.count" 2)
    (state-set "pkg.offset" 0)
    (state-set "pkg.total" 25)
    (state-set "pkg.status" "builds 1-2 of 25"))

windows:
  - window: test
    id: main
    pos: [0, 0]
    size: [800, 464]
    children:
      - include: package_view

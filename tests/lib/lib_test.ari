# Unit tests for share/cypkg/lib.ari's functions, run with `ari test` (tests/lib.sh). No network
# and no state: each test calls functions with values and asserts on what comes back.

meta:
  name: cypkg-lib-test
  min_libcvc: 3.7.4

import: ../../share/cypkg/lib.ari

tests:
  field reads a field, and nil for a missing one: |
    (begin
      (assert (= (field (dict "a" 1) "a") 1))
      (assert (= (field (dict "a" 1) "b") nil))
      (assert (= (field (json-parse "{\"a\": null}") "a") nil)))

  text makes nil empty and leaves strings alone: |
    (begin
      (assert (= (text nil) ""))
      (assert (= (text "zlib") "zlib"))
      (assert (= (text 42) "42")))

  int-or falls back for nil and empty: |
    (begin
      (assert (= (int-or "12" 0) 12))
      (assert (= (int-or 7 0) 7))
      (assert (= (int-or nil 10) 10))
      (assert (= (int-or "" 10) 10)))

  reply-object takes only a 200 with a JSON object: |
    (begin
      (assert (= (field (reply-object (dict "status" 200 "body" "{\"total\": 3}")) "total") 3))
      (assert (= (reply-object (dict "status" 500 "body" "{\"total\": 3}")) nil) "a 500")
      (assert (= (reply-object (dict "status" 200 "body" "<html>")) nil) "not JSON")
      (assert (= (reply-object (dict "status" 200 "body" "[1, 2]")) nil) "an array")
      (assert (= (reply-object (dict "status" 200 "body" "")) nil) "empty"))

  reply-rows takes only a list of packages: |
    (begin
      (assert (= (length (reply-rows (json-parse "{\"packages\": [1, 2]}"))) 2))
      (assert (= (length (reply-rows (json-parse "{\"packages\": []}"))) 0))
      (assert (= (reply-rows (json-parse "{\"packages\": \"x\"}")) nil))
      (assert (= (reply-rows (json-parse "{\"total\": 0}")) nil))
      (assert (= (reply-rows nil) nil)))

  failure names the error or the status: |
    (begin
      (assert (= (failure (dict "status" 0 "error" "Could not connect")) "Could not connect"))
      (assert (= (failure (dict "status" 0 "error" nil)) ""))
      (assert (= (failure (dict "status" 503 "error" "")) "HTTP 503")))

  all means no filter: |
    (begin
      (assert (= (filter-value "all") ""))
      (assert (= (filter-value "linux") "linux")))

  search-query sends the filters, the page and facets: |
    (begin
      (set q (search-query "zlib" "all" "arm64" "static" 10 20 #t))
      (assert (= (get-attr q "q") "zlib"))
      (assert (= (get-attr q "platform") ""))
      (assert (= (get-attr q "arch") "arm64"))
      (assert (= (get-attr q "link") "static"))
      (assert (= (get-attr q "limit") 10))
      (assert (= (get-attr q "offset") 20))
      (assert (= (get-attr q "facets") "true"))
      (assert (= (get-attr (search-query "zlib" "all" "all" "all" 10 10 #f) "facets") "false")))

  search-key ignores paging and names the filters: |
    (begin
      (assert (= (search-key "zlib" "all" "all" "all") "zlib|all|all|all"))
      (assert (!= (search-key "zlib" "linux" "all" "all") (search-key "zlib" "all" "all" "all"))))

  body-text decodes bytes and leaves text: |
    (begin
      (assert (= (body-text (dict "body" (string.encode "{}"))) "{}"))
      (assert (= (body-text (dict "body" "{}")) "{}"))
      (assert (= (body-text (dict "body" nil)) "")))

  progress-bar sweeps a block across and back: |
    (begin
      (assert (= (progress-bar 0 20) "") "idle")
      (assert (= (string.length (progress-bar 1 20)) 20))
      (assert (= (progress-bar 1 20) "·██████·············"))
      (assert (= (progress-bar 14 20) "··············██████") "the far end")
      (assert (= (progress-bar 15 20) "·············██████·") "and back")
      (assert (= (progress-bar 28 20) "██████··············") "home again"))

  search-status counts rows and packages: |
    (begin
      (assert (= (search-status 0 10 196 10) "builds 1-10 of 196, 10 packages"))
      (assert (= (search-status 20 5 25 1) "builds 21-25 of 25, 1 package"))
      (assert (= (search-status 0 3 3 nil) "builds 1-3 of 3"))
      (assert (= (search-status 0 0 0 0) "no builds match")))

  search-failure says what went wrong: |
    (begin
      (assert (= (search-failure (dict "status" 500 "error" ""))
                 "search failed: HTTP 500"))
      (assert (= (search-failure (dict "status" 0 "error" "Could not connect"))
                 "search failed: Could not connect"))
      (assert (= (search-failure (dict "status" 200 "error" ""))
                 "search failed: the registry's reply was not a search result")))

  package-failure tells an unknown name from an error: |
    (begin
      (assert (= (package-failure (dict "status" 200 "error" "") (list) "nope") "no package named nope"))
      (assert (= (package-failure (dict "status" 404 "error" "") nil "nope") "no package named nope"))
      (assert (= (package-failure (dict "status" 200 "error" "") nil "x")
                 "failed: the registry's reply was not a package"))
      (assert (= (package-failure (dict "status" 500 "error" "") nil "x") "failed: HTTP 500")))

  cut leaves short text and cuts long text to n: |
    (begin
      (assert (= (cut "zlib" 92) "zlib"))
      (assert (= (cut "" 92) ""))
      (set long (string.join (list "0123456789" "0123456789" "0123456789" "0123456789"
                                   "0123456789" "0123456789" "0123456789" "0123456789"
                                   "0123456789" "0123456789") ""))
      (assert (= (string.length (cut long 92)) 92))
      (assert (string.ends-with (cut long 92) "..."))
      (assert (= (cut (string.substring long 0 92) 92) (string.substring long 0 92)) "exactly n"))

  size-text shows bytes under 1 KB, then whole KB: |
    (begin
      (assert (= (size-text "") ""))
      (assert (= (size-text nil) ""))
      (assert (= (size-text 1) "1 B"))
      (assert (= (size-text "1023") "1023 B"))
      (assert (= (size-text 1024) "1 KB"))
      (assert (= (size-text "164219") "160 KB")))

  date-text keeps the date: |
    (begin
      (assert (= (date-text "2026-10-30T06:23:20.162Z") "2026-10-30"))
      (assert (= (date-text "2026-10-30") "2026-10-30"))
      (assert (= (date-text "") "")))

  build-row formats a table row: |
    (begin
      (set r (build-row "1.3.1+cvc.5" "linux" "x86_64" "release" "shared" "164219"
                        "2026-09-26T00:00:00Z"))
      (assert (= (get-attr r "version") "1.3.1+cvc.5"))
      (assert (= (get-attr r "where") "linux/x86_64"))
      (assert (= (get-attr r "kind") "release shared"))
      (assert (= (get-attr r "size") "160 KB"))
      (assert (= (get-attr r "date") "2026-09-26")))

  page-bounds pages, ends partial pages, and wraps a past-the-end offset: |
    (begin
      (set b (lambda (off page total) (page-bounds off page total)))
      (assert (= (str (b 0 10 25)) (str (list 0 10))))
      (assert (= (str (b 20 10 25)) (str (list 20 25))))
      (assert (= (str (b 10 10 20)) (str (list 10 20))) "an exact last page")
      (assert (= (str (b 99 10 25)) (str (list 0 10))) "past the end")
      (assert (= (str (b 25 10 25)) (str (list 0 10))) "at the end")
      (assert (= (str (b 0 10 0)) (str (list 0 0))) "nothing"))

  live-url maps a server to its feed: |
    (begin
      (assert (= (live-url "https://cvcpkg.org") "wss://cvcpkg.org/v1/live/ws"))
      (assert (= (live-url "http://127.0.0.1:8765") "ws://127.0.0.1:8765/v1/live/ws")))

  live-final is 4004 and 4001 only: |
    (begin
      (assert (live-final 4004))
      (assert (live-final 4001))
      (assert (not (live-final 1006)))
      (assert (not (live-final 0)))
      (assert (not (live-final nil))))

  live-note says where rows come from: |
    (begin
      (assert (= (live-note "live") " · live"))
      (assert (= (live-note "offline") " · polling"))
      (assert (= (live-note "off") ""))
      (assert (= (live-note "idle") "")))

  hello-text asks for its topics: |
    (begin
      (set h (json-parse (hello-text (list "builders" "builds"))))
      (assert (= (get-attr h "type") "hello"))
      (assert (= (str (get-attr h "topics")) (str (list "builders" "builds")))))

  builder-row keeps what the window shows, not the capabilities: |
    (begin
      (set r (builder-row (dict "id" 3 "name" "star-00" "status" "online" "capabilities"
                                (dict "glibc2.35" #t))))
      (assert (= (get-attr r "name") "star-00"))
      (assert (= (get-attr r "id") 3))
      (assert (= (field r "capabilities") nil)))

  iso-epoch reads the server's timestamps as seconds since the epoch: |
    (begin
      (assert (= (iso-epoch "2026-11-26T09:11:29.882561Z") 1795684289))
      (assert (= (iso-epoch "1999-02-28T23:59:59") 920246399))
      (assert (= (iso-epoch "2000-03-01T00:00:00Z") 951868800))
      (assert (= (iso-epoch "") nil))
      (assert (= (iso-epoch "not a time at all") nil)))

  ago says how long ago, as the web app does: |
    (begin
      (assert (= (ago-text 0) "just now"))
      (assert (= (ago-text 12) "12 s ago"))
      (assert (= (ago-text 300) "5 min ago"))
      (assert (= (ago-text 7200) "2 h ago"))
      (assert (= (ago-text 172800) "2 d ago"))
      (assert (= (ago "2026-11-26T09:11:29Z" (+ 1795684289 7200)) "2 h ago"))
      (assert (= (ago "garbage" 0) "garbage"))
      (assert (= (span-text 887396.9) "10 d 6 h"))
      (assert (= (span-text 5400) "1 h 30 min")))

  meters, sizes and percentages: |
    (begin
      (assert (= (meter 0.5 4) "▕██░░▏"))
      (assert (= (meter 2 2) "▕██▏"))
      (assert (= (gb-text 33508810752) "31.2 GB"))
      (assert (= (pct-text 0.283) "28%"))
      (assert (= (used 25 100) 0.75))
      (assert (= (used 1 0) 0))
      (assert (= (list-text (list)) "—"))
      (assert (= (list-text (list "a" "b")) "a, b")))

  builder-card draws a builder as the web app's card: |
    (begin
      (set b (dict "id" 1 "name" "star-00" "platform" "linux" "arch" "x86_64" "status" "online"
                   "org_slug" "" "labels" (list "cvcpkg=2.5.15") "current_jobs" 0 "max_jobs" 4
                   "version" "2.5.15" "last_heartbeat" "2026-11-26T09:11:29Z"
                   "system" (dict "cpu_count" 4 "cpu_percent" 28.3 "mem_total_bytes" 100
                                  "mem_available_bytes" 28 "disk_total_bytes" 100 "disk_free_bytes" 73)
                   "capabilities" (dict "cross_platforms" (list (dict "platform" "wasm" "arch" "wasm32"))
                                        "glibc2.35" #t "docker" #f)))
      (set c (builder-card b (+ 1795684289 12)))
      (assert (= (get-attr c "head") "star-00  online  linux/x86_64  v2.5.15") (get-attr c "head"))
      (assert (= (get-attr c "load") "jobs 0/4  cpu ▕██░░░░▏ 28%  mem ▕████░░▏ 72%  disk ▕██░░░░▏ 27%")
              (get-attr c "load"))
      (assert (= (get-attr c "seen") "heartbeat 12 s ago  ·  org —  ·  cvcpkg=2.5.15") (get-attr c "seen"))
      (assert (= (seen-text (get-attr c "hb") (get-attr c "seen_tail") (+ 1795684289 120))
                 "heartbeat 2 min ago  ·  org —  ·  cvcpkg=2.5.15"))
      (assert (= (field c "capabilities") nil))
      (set off (builder-card (dict "id" 9 "name" "netbsd" "status" "offline" "platform" "netbsd"
                                   "arch" "x86_64" "current_jobs" 0 "max_jobs" 2) 0))
      (assert (= (get-attr off "head") "netbsd  offline  netbsd/x86_64") (get-attr off "head"))
      (assert (= (get-attr off "load") "jobs 0/2  ·  no host report") (get-attr off "load")))

  builder-detail lists what a builder builds: |
    (begin
      (set b (dict "id" 1 "name" "star-00" "status" "online"
                   "capabilities" (dict "cross_platforms" (list (dict "platform" "wasm" "arch" "wasm32"))
                                        "glibc2.35" #t "docker" #f)))
      (set d (builder-detail b 0))
      (assert (= (get-attr d "title") "star-00  ·  online"))
      (assert (= (nth (get-attr d "host") 0) "no host report yet"))
      (assert (= (nth (get-attr d "builds") 1) "cross wasm/wasm32"))
      (assert (= (nth (get-attr d "builds") 2) "flags glibc2.35")))

  job-row and event-row: |
    (begin
      (assert (= (job-row (dict "id" 7 "status" "running" "recipe_name" "zlib" "recipe_version" "1.3.1"
                                "started_at" "2026-11-26T09:00:00Z" "submitted_at" "2026-11-26T08:59:00Z")
                          1795684289)
                 "#7  running  zlib 1.3.1  11 min  12 min ago"))
      (set e (event-row (dict "id" 1 "kind" "publish" "name" "zlib" "version" "1.3.1+cvc.6"
                              "platform" "linux" "arch" "x86_64" "build_type" "release" "link" "shared"
                              "org_slug" "" "actor" "ci" "detail" "" "size_bytes" 165000
                              "created_at" "2026-11-26T09:06:29Z")
                        1795684289))
      (assert (= (get-attr e "when") "5 min ago"))
      (assert (= (get-attr e "what") "zlib 1.3.1+cvc.6"))
      (assert (= (get-attr e "where") "linux/x86_64 shared"))
      (assert (= (get-attr e "org") "—"))
      (assert (= (get-attr e "size") "161 KB"))
      (assert (event-matches (dict "kind" "yank" "name" "LibGLVND") "yank" "glvnd"))
      (assert (not (event-matches (dict "kind" "yank" "name" "zlib") "publish" ""))))

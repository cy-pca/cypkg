# The package module (share/cypkg/package.ari) on its own.
#
# A module test: this document mounts only package.ari, against the fixture registry, through the
# same holes main.ari grants (args, view, nav). Each test drives the module through its state at
# includes.p.*, the way its view does, waits for its pkg.seq to
# count one more finished request, and asserts on what its view reads. tests/modules.sh puts the
# fixture's URL in place of @SERVER@ and runs `ari test`. Fixture numbers: 196 builds of 10
# packages; zstd has 25 builds, 5 of them linux.

meta:
  name: cypkg-package-test
  min_libcvc: 3.7.4

requires: [net]

args:
  server: {type: string, default: "@SERVER@"}
  q: {type: string, default: ""}
  platform: {type: string, default: all}
  arch: {type: string, default: all}
  link: {type: string, default: all}
  offset: {type: int, default: 0}
  page: {type: int, default: 10}

init: |
  (begin
    (state-set "view" "package")
    (state-set "nav.open" "")
    (state-set "nav.start" 0))

windows:
  - window: test
    children:
      - load: ../../share/cypkg/package.ari
        as: p
        link:
          args: { to: args, mode: ro }
          view: view
          nav: nav

tests:
  opening a package shows its first builds: |
    (begin
      (set n (int (state-get "includes.p.pkg.seq")))
      (state-set "nav.open" "zstd")
      (set i 0)
      (while (if (<= (int (state-get "includes.p.pkg.seq")) n) (< i 500) #f) (sleep 0.02) (set i (+ i 1)))
      (assert (= (state-get "view") "package"))
      (assert (= (state-get "includes.p.pkg.name") "zstd"))
      (assert (= (state-get "includes.p.pkg.total") "25") (state-get "includes.p.pkg.total"))
      (assert (= (state-get "includes.p.pkg.count") "10") (state-get "includes.p.pkg.count"))
      (assert (= (state-get "includes.p.pkg.install") "cvcpkg install zstd"))
      (assert (= (state-get "includes.p.pkg.status") "builds 1-10 of 25") (state-get "includes.p.pkg.status")))

  a build row is formatted for the table: |
    (begin
      (assert (string.contains (state-get "includes.p.pkg.page.0.where") "/") (state-get "includes.p.pkg.page.0.where"))
      (assert (string.ends-with (state-get "includes.p.pkg.page.0.size") " KB") (state-get "includes.p.pkg.page.0.size"))
      (assert (= (string.length (state-get "includes.p.pkg.page.0.date")) 10) (state-get "includes.p.pkg.page.0.date")))

  the last page of builds is partial: |
    (begin
      (set n (int (state-get "includes.p.pkg.seq")))
      (state-set "includes.p.pkg.offset" 20)
      (state-set "includes.p.req.pkgpage" "1")
      (set i 0)
      (while (if (<= (int (state-get "includes.p.pkg.seq")) n) (< i 500) #f) (sleep 0.02) (set i (+ i 1)))
      (assert (= (state-get "includes.p.pkg.count") "5") (state-get "includes.p.pkg.count"))
      (assert (= (state-get "includes.p.pkg.status") "builds 21-25 of 25")))

  an offset past the end goes back to the first page: |
    (begin
      (set n (int (state-get "includes.p.pkg.seq")))
      (state-set "includes.p.pkg.offset" 99)
      (state-set "includes.p.req.pkgpage" "1")
      (set i 0)
      (while (if (<= (int (state-get "includes.p.pkg.seq")) n) (< i 500) #f) (sleep 0.02) (set i (+ i 1)))
      (assert (= (state-get "includes.p.pkg.offset") "0") (state-get "includes.p.pkg.offset"))
      (assert (= (state-get "includes.p.pkg.status") "builds 1-10 of 25")))

  null fields become empty text: |
    (begin
      (set n (int (state-get "includes.p.pkg.seq")))
      (state-set "nav.open" "edge-nulls")
      (set i 0)
      (while (if (<= (int (state-get "includes.p.pkg.seq")) n) (< i 500) #f) (sleep 0.02) (set i (+ i 1)))
      (assert (= (state-get "includes.p.pkg.license") "") (state-get "includes.p.pkg.license"))
      (assert (= (state-get "includes.p.pkg.desc") "") (state-get "includes.p.pkg.desc"))
      (assert (= (state-get "includes.p.pkg.page.0.size") "") (state-get "includes.p.pkg.page.0.size"))
      (assert (= (state-get "includes.p.pkg.page.0.date") "") (state-get "includes.p.pkg.page.0.date")))

  a long description is cut to the window: |
    (begin
      (set n (int (state-get "includes.p.pkg.seq")))
      (state-set "nav.open" "edge-unicode-zoë")
      (set i 0)
      (while (if (<= (int (state-get "includes.p.pkg.seq")) n) (< i 500) #f) (sleep 0.02) (set i (+ i 1)))
      (assert (= (string.length (state-get "includes.p.pkg.desc")) 92) (state-get "includes.p.pkg.desc"))
      (assert (string.ends-with (state-get "includes.p.pkg.desc") "...")))

  an unknown package says so: |
    (begin
      (set n (int (state-get "includes.p.pkg.seq")))
      (state-set "nav.open" "no-such-package")
      (set i 0)
      (while (if (<= (int (state-get "includes.p.pkg.seq")) n) (< i 500) #f) (sleep 0.02) (set i (+ i 1)))
      (assert (= (state-get "includes.p.pkg.count") "0"))
      (assert (= (state-get "includes.p.pkg.status") "no package named no-such-package")
              (state-get "includes.p.pkg.status")))

  an HTTP error opening a package is a status: |
    (begin
      (set n (int (state-get "includes.p.pkg.seq")))
      (state-set "nav.open" "fault-500")
      (set i 0)
      (while (if (<= (int (state-get "includes.p.pkg.seq")) n) (< i 500) #f) (sleep 0.02) (set i (+ i 1)))
      (assert (= (state-get "includes.p.pkg.status") "failed: HTTP 500") (state-get "includes.p.pkg.status")))

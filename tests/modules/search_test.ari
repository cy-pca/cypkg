# The search module (share/cypkg/search.ari) on its own.
#
# A module test: this document mounts only search.ari, against the fixture registry, through the
# same holes main.ari grants (args, view, nav). Each test drives the module through its state at
# includes.s.*, the way its view does, waits for its search.seq to
# count one more finished request, and asserts on what its view reads. tests/modules.sh puts the
# fixture's URL in place of @SERVER@ and runs `ari test`. Fixture numbers: 196 builds of 10
# packages; zstd has 25 builds, 5 of them linux.

meta:
  name: cypkg-search-test
  min_libcvc: 3.7.4

requires: [net]

args:
  server: {type: string, default: "@SERVER@"}
  q: {type: string, default: ""}
  platform: {type: string, default: all}
  arch: {type: string, default: all}
  link: {type: string, default: all}
  offset: {type: int, default: 0}
  page: {type: int, default: 10}

init: |
  (begin
    (state-set "view" "search")
    (state-set "nav.open" "")
    (state-set "nav.start" 0))

windows:
  - window: test
    children:
      - load: ../../share/cypkg/search.ari
        as: s
        link:
          args: { to: args, mode: ro }
          view: view
          nav: nav

tests:
  the start-up search lists every build: |
    (begin
      (set i 0)
      (while (if (< (int (state-get "includes.s.search.seq")) 1) (< i 500) #f) (sleep 0.02) (set i (+ i 1)))
      (assert (= (state-get "includes.s.search.total") "196") (state-get "includes.s.search.total"))
      (assert (= (state-get "includes.s.search.count") "10") (state-get "includes.s.search.count"))
      (assert (= (state-get "includes.s.search.status") "builds 1-10 of 196, 10 packages")
              (state-get "includes.s.search.status")))

  a query narrows the search: |
    (begin
      (set n (int (state-get "includes.s.search.seq")))
      (state-set "includes.s.search.q" "zstd")
      (state-set "includes.s.search.offset" 0)
      (state-set "includes.s.req.search" "1")
      (set i 0)
      (while (if (<= (int (state-get "includes.s.search.seq")) n) (< i 500) #f) (sleep 0.02) (set i (+ i 1)))
      (assert (= (state-get "includes.s.search.total") "25") (state-get "includes.s.search.total"))
      (assert (= (state-get "includes.s.search.res.packages.0.name") "zstd"))
      (assert (= (state-get "includes.s.search.status") "builds 1-10 of 25, 1 package")
              (state-get "includes.s.search.status")))

  Next pages the search: |
    (begin
      (set n (int (state-get "includes.s.search.seq")))
      (state-set "includes.s.search.offset" 10)
      (state-set "includes.s.req.search" "1")
      (set i 0)
      (while (if (<= (int (state-get "includes.s.search.seq")) n) (< i 500) #f) (sleep 0.02) (set i (+ i 1)))
      (assert (= (state-get "includes.s.search.count") "10"))
      (assert (= (state-get "includes.s.search.status") "builds 11-20 of 25, 1 package")
              (state-get "includes.s.search.status")))

  the last page is partial: |
    (begin
      (set n (int (state-get "includes.s.search.seq")))
      (state-set "includes.s.search.offset" 20)
      (state-set "includes.s.req.search" "1")
      (set i 0)
      (while (if (<= (int (state-get "includes.s.search.seq")) n) (< i 500) #f) (sleep 0.02) (set i (+ i 1)))
      (assert (= (state-get "includes.s.search.count") "5") (state-get "includes.s.search.count"))
      (assert (= (state-get "includes.s.search.status") "builds 21-25 of 25, 1 package")))

  a filter change searches again from the first row: |
    (begin
      (set n (int (state-get "includes.s.search.seq")))
      (state-set "includes.s.search.platform" "linux")
      (set i 0)
      (while (if (<= (int (state-get "includes.s.search.seq")) n) (< i 500) #f) (sleep 0.02) (set i (+ i 1)))
      (assert (= (state-get "includes.s.search.offset") "0") (state-get "includes.s.search.offset"))
      (assert (= (state-get "includes.s.search.total") "5") (state-get "includes.s.search.total"))
      (assert (= (state-get "includes.s.search.res.packages.0.platform") "linux")))

  the all option sends no filter: |
    (begin
      (set n (int (state-get "includes.s.search.seq")))
      (state-set "includes.s.search.platform" "all")
      (set i 0)
      (while (if (<= (int (state-get "includes.s.search.seq")) n) (< i 500) #f) (sleep 0.02) (set i (+ i 1)))
      (assert (= (state-get "includes.s.search.total") "25") (state-get "includes.s.search.total")))

  an HTTP error is a status, not a crash: |
    (begin
      (set n (int (state-get "includes.s.search.seq")))
      (state-set "includes.s.search.q" "fault-500")
      (state-set "includes.s.req.search" "1")
      (set i 0)
      (while (if (<= (int (state-get "includes.s.search.seq")) n) (< i 500) #f) (sleep 0.02) (set i (+ i 1)))
      (assert (= (state-get "includes.s.search.count") "0"))
      (assert (= (state-get "includes.s.search.status") "search failed: HTTP 500") (state-get "includes.s.search.status")))

  a reply that isn't JSON is a status: |
    (begin
      (set n (int (state-get "includes.s.search.seq")))
      (state-set "includes.s.search.q" "fault-badjson")
      (state-set "includes.s.req.search" "1")
      (set i 0)
      (while (if (<= (int (state-get "includes.s.search.seq")) n) (< i 500) #f) (sleep 0.02) (set i (+ i 1)))
      (assert (= (state-get "includes.s.search.count") "0"))
      (assert (= (state-get "includes.s.search.status")
                 "search failed: the registry's reply was not a search result")))

  a reply of the wrong shape is a status: |
    (begin
      (set n (int (state-get "includes.s.search.seq")))
      (state-set "includes.s.search.q" "fault-shape")
      (state-set "includes.s.req.search" "1")
      (set i 0)
      (while (if (<= (int (state-get "includes.s.search.seq")) n) (< i 500) #f) (sleep 0.02) (set i (+ i 1)))
      (assert (= (state-get "includes.s.search.total") "0"))
      (assert (= (state-get "includes.s.search.status")
                 "search failed: the registry's reply was not a search result")))
